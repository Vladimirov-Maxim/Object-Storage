#Область ПрограммныйИнтерфейс

// Интерактивная работа с полем ввода типа пароль для отображения команды Показать/Скрыть
//
// Параметры:
//   Элемент - ПолеВвода - элемент формы с паролем
//   Реквизит - РеквизитФормы - реквизит, в котором хранится значение пароля
//   СтандартнаяОбработка - Булево - стандартная обработка начало выбора у поля ввода
//
Процедура ПолеПароляНачалоВыбора(Элемент, Реквизит, СтандартнаяОбработка) Экспорт

	СтандартнаяОбработка = Ложь;

	Реквизит = Элемент.ТекстРедактирования;
	Элемент.РежимПароля = Не Элемент.РежимПароля;

	Если Элемент.РежимПароля Тогда
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.ПоказатьПароль;
	Иначе
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.СкрытьПароль;
	КонецЕсли;

КонецПроцедуры

#Область ОбщегоНазначения

// Формирует и выводит сообщение пользователю (клиентский вариант).
//
// Параметры:
//  Текст - Строка - текст сообщения пользователю.
//
Процедура СообщитьПользователю(Текст) Экспорт
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#Область ФайловаяСистема

// Обёртка ФайловаяСистемаКлиент.ВыбратьКаталог.
//
// Параметры:
//  Оповещение - ОписаниеОповещения - обработчик, вызываемый после выбора каталога.
//  Заголовок - Строка - заголовок диалога выбора каталога.
//
Процедура ВыбратьКаталог(Оповещение, Заголовок) Экспорт
	Если Не ПодсистемаСуществует("СтандартныеПодсистемы.БазоваяФункциональность") Тогда
		ВызватьИсключение ох_ОбщегоНазначенияКлиентСервер.ТекстОшибкиНедоступнаЗависимость(
			"СтандартныеПодсистемы.БазоваяФункциональность");
	КонецЕсли;
	ОбщийМодуль("ФайловаяСистемаКлиент").ВыбратьКаталог(Оповещение, Заголовок);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ЯдроОстрова

// Возвращает признак использования БСП. Метаданные на тонком/веб-клиенте недоступны, переменной
// модуля приложения в острове нет - определяем наличие попыткой получить БСП-модуль строкой.
//
// Возвращаемое значение:
//  Булево - Истина, если в конфигурации есть подсистема БСП.
//
Функция ИспользуетсяБСП() Экспорт
	Возврат МодульДоступен("ОбщегоНазначенияКлиент");
КонецФункции

// Признак доступности общего модуля на клиенте. Пробуем вычислить имя модуля;
// нет модуля - Вычислить бросает исключение, гасим и возвращаем Ложь.
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  Булево - Истина, если общий модуль присутствует в конфигурации.
//
Функция МодульДоступен(Имя) Экспорт
	Попытка
		Модуль = Вычислить(Имя);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	#Если Не ВебКлиент Тогда
	Возврат ТипЗнч(Модуль) = Тип("ОбщийМодуль");
	#КонецЕсли
	Возврат Модуль <> Неопределено;
КонецФункции

// Возвращает признак наличия указанной подсистемы БСП. Образец - ОбщегоНазначенияБПОКлиент.ПодсистемаСуществует.
//
// Параметры:
//  ПолноеИмяПодсистемы - Строка - полное имя подсистемы, например "СтандартныеПодсистемы.БазоваяФункциональность".
//
// Возвращаемое значение:
//  Булево - Истина, если подсистема присутствует в конфигурации.
//
Функция ПодсистемаСуществует(ПолноеИмяПодсистемы) Экспорт
	Если ИспользуетсяБСП() Тогда
		Возврат ОбщийМодуль("ОбщегоНазначенияКлиент").ПодсистемаСуществует(ПолноеИмяПодсистемы);
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Возвращает общий модуль БСП по имени (делегирование строкой). Калька клиентского эталона
// ОбщегоНазначенияКлиент.ОбщийМодуль, включая проверку в тонком клиенте/вебклиенте.
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  ОбщийМодуль - найденный общий модуль.
//
Функция ОбщийМодуль(Имя) Экспорт

	Модуль = Вычислить(Имя);

	#Если Не ВебКлиент Тогда
	Если ТипЗнч(Модуль) <> Тип("ОбщийМодуль") Тогда
		ВызватьИсключение ТекстОшибкиНедоступенМодуль(Имя);
	КонецЕсли;
	#КонецЕсли

	Возврат Модуль;

КонецФункции

// Формирует человекочитаемый текст исключения об отсутствии общего модуля.
//
// Параметры:
//  Имя - Строка - имя недостающего общего модуля.
//
// Возвращаемое значение:
//  Строка - текст исключения.
//
Функция ТекстОшибкиНедоступенМодуль(Имя) Экспорт
	Возврат ох_ОбщегоНазначенияКлиентСервер.ТекстОшибкиНедоступнаЗависимость(Имя, "общий модуль");
КонецФункции

#КонецОбласти

#КонецОбласти