#Область ПроверкаНаличияЗависимостей

// Возвращает признак использования БСП (наличия подсистемы "СтандартныеПодсистемы.БазоваяФункциональность").
// Кешируется на время сеанса (см. ох_ОбщегоНазначения.ИспользуетсяБСП), образец ОбщегоНазначенияБПО.ИспользуетсяБСП.
//
// Возвращаемое значение:
//  Булево - Истина, если в конфигурации есть подсистема БСП.
//
Функция ИспользуетсяБСП() Экспорт

	СтандартныеПодсистемы = Метаданные.Подсистемы.Найти("СтандартныеПодсистемы");
	Если СтандартныеПодсистемы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтандартныеПодсистемы.Подсистемы.Найти("БазоваяФункциональность") <> Неопределено;

КонецФункции

// Возвращает признак наличия указанной подсистемы БСП. Кешируется на время сеанса.
//
// Параметры:
//  ПолноеИмяПодсистемы - Строка - полное имя подсистемы БСП, например "СтандартныеПодсистемы.РаботаСФайлами".
//
// Возвращаемое значение:
//  Булево - Истина, если подсистема присутствует в конфигурации.
//
Функция ПодсистемаДоступна(ПолноеИмяПодсистемы) Экспорт

	Если Не ИспользуетсяБСП() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ох_ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначения").ПодсистемаСуществует(ПолноеИмяПодсистемы);

КонецФункции

// Возвращает признак наличия общего модуля с указанным именем. Кешируется на время сеанса.
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  Булево - Истина, если общий модуль присутствует в конфигурации.
//
Функция МодульДоступен(Имя) Экспорт
	Возврат Метаданные.ОбщиеМодули.Найти(Имя) <> Неопределено;
КонецФункции

#КонецОбласти