
#Область СлужебныйПрограммныйИнтерфейс

// Формирует человекочитаемый текст исключения об отсутствии внешней зависимости.
// Единый помощник для серверного и клиентского ТекстОшибкиНедоступенМодуль (см. ох_ОбщегоНазначения,
// ох_ОбщегоНазначенияКлиент).
//
// Параметры:
//  ИмяЗависимости - Строка - имя недостающей подсистемы/общего модуля.
//  ВидЗависимости - Строка - вид зависимости, по умолчанию "подсистема".
//
// Возвращаемое значение:
//  Строка - текст исключения.
//
Функция ТекстОшибкиНедоступнаЗависимость(ИмяЗависимости, ВидЗависимости = "подсистема") Экспорт
	Возврат СтрШаблон(
		НСтр("ru = 'Для работы ""Объектного хранилища"" требуется %1 ""%2"", которая отсутствует в конфигурации.
		|Установите её или отключите интеграцию объектного хранилища.'"),
		ВидЗависимости, ИмяЗависимости);
КонецФункции

// Возвращает признак наличия подсистемы БСП. На сервере делегирует ох_ОбщегоНазначения, на клиенте -
// ох_ОбщегоНазначенияКлиент (в клиент-серверном модуле нет прямого доступа ни к Метаданные, ни к ПараметрПриложения).
//
// Параметры:
//  ПолноеИмяПодсистемы - Строка - полное имя подсистемы БСП.
//
// Возвращаемое значение:
//  Булево - Истина, если подсистема присутствует.
//
Функция ПодсистемаСуществует(ПолноеИмяПодсистемы) Экспорт

	#Если Сервер Тогда
		Возврат ох_ОбщегоНазначения.ПодсистемаСуществует(ПолноеИмяПодсистемы);
	#Иначе
		Возврат ох_ОбщегоНазначенияКлиент.ПодсистемаСуществует(ПолноеИмяПодсистемы);
	#КонецЕсли

КонецФункции

// Дополняет структуру-приёмник значениями из структуры-источника с учётом режима.
//
// Параметры:
//  Приемник - Структура - коллекция, в которую добавляются значения.
//  Источник - Структура - коллекция, из которой берутся пары Ключ и Значение.
//  Режим - Строка - поведение при совпадении ключей:
//   "Заменять" (по умолчанию) - перезаписывать значение приёмника;
//   "ЗаменятьПустые" - записывать, только если текущее значение приёмника не заполнено;
//   "НеЗаменять" - записывать только отсутствующие в приёмнике ключи.
//
Процедура ДополнитьСтруктуру(Приемник, Источник, Режим = "Заменять") Экспорт

	Для Каждого Элемент Из Источник Цикл

		Если Режим = "ЗаменятьПустые" Тогда
			Значение = СвойствоСтруктуры(Приемник, Элемент.Ключ);
			
			Если Не ЗначениеЗаполнено(Значение) Тогда
				Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЕсли;
			
		ИначеЕсли Режим = "НеЗаменять"
			И Не Приемник.Свойство(Элемент.Ключ) Тогда
			Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
			
		Иначе
			Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
 
// Помещает переданные значения (от 2 до 5) в новый массив и возвращает его.
//
// Параметры:
//  Элемент1 - Произвольный - первое значение (обязательное).
//  Элемент2 - Произвольный - второе значение (обязательное).
//  Элемент3 - Произвольный - третье значение (необязательное).
//  Элемент4 - Произвольный - четвёртое значение (необязательное).
//  Элемент5 - Произвольный - пятое значение (необязательное).
//
// Возвращаемое значение:
//  Массив - массив из переданных значений.
//
Функция ЗначенияВМассиве(
	Элемент1,
	Элемент2, 
	Элемент3 = "440e3512-0df8-4081-a10d-9dc877fbe625", 
	Элемент4 = "440e3512-0df8-4081-a10d-9dc877fbe625", 
	Элемент5 = "440e3512-0df8-4081-a10d-9dc877fbe625") Экспорт
 
	НебольшойМассив = Новый Массив;
	НебольшойМассив.Добавить(Элемент1);
	НебольшойМассив.Добавить(Элемент2);
	
	Если Элемент3 <> "440e3512-0df8-4081-a10d-9dc877fbe625" Тогда
		НебольшойМассив.Добавить(Элемент3);
	КонецЕсли;
	
	Если Элемент4 <> "440e3512-0df8-4081-a10d-9dc877fbe625" Тогда
		НебольшойМассив.Добавить(Элемент4);
	КонецЕсли;
	
	Если Элемент5 <> "440e3512-0df8-4081-a10d-9dc877fbe625" Тогда
		НебольшойМассив.Добавить(Элемент5);
	КонецЕсли;
	
	Возврат НебольшойМассив;

КонецФункции

// Возвращает общий модуль БСП по имени (делегирование строкой). На сервере зовёт ох_ОбщегоНазначения,
// на клиенте - ох_ОбщегоНазначенияКлиент.
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  ОбщийМодуль - найденный общий модуль.
//
Функция ОбщийМодуль(Имя) Экспорт

	#Если Сервер Тогда
		Возврат ох_ОбщегоНазначения.ОбщийМодуль(Имя);
	#Иначе
		Возврат ох_ОбщегоНазначенияКлиент.ОбщийМодуль(Имя);
	#КонецЕсли

КонецФункции

// Создаёт массив и помещает в него переданное значение.
//
// Параметры:
//  Значение - Произвольный - значение, которое нужно упаковать в массив.
//
// Возвращаемое значение:
//  Массив - массив из одного элемента Значение.
//
Функция ЗначениеВМассиве(Значение) Экспорт
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

// Обёртка ОбщегоНазначенияКлиентСервер.ПроверитьПараметр.
//
// Параметры:
//  ИмяПроцедуры - Строка - имя процедуры или функции, параметр которой проверяется.
//  ИмяПараметра - Строка - имя проверяемого параметра.
//  Значение - Произвольный - фактическое значение параметра.
//  ОжидаемыеТипы - Тип, Массив, ОписаниеТипов - ожидаемый тип(ы) значения.
//
Процедура ПроверитьПараметр(ИмяПроцедуры, ИмяПараметра, Значение, ОжидаемыеТипы) Экспорт
	ОбщийМодуль("ОбщегоНазначенияКлиентСервер").ПроверитьПараметр(ИмяПроцедуры, ИмяПараметра, Значение, ОжидаемыеТипы);
КонецПроцедуры

// Получает строку, содержащую ключи структуры, разделённые запятой.
//
// Параметры:
//  Структура - Структура - структура, ключи которой преобразуются в строку.
//
// Возвращаемое значение:
//  Строка - строка, содержащая ключи структуры, разделённые запятой.
//
Функция КлючиСтруктурыВСтроку(Структура) Экспорт
	Результат = "";
	Для Каждого Элемент Из Структура Цикл
		СимволРазделителя = ?(ПустаяСтрока(Результат), "", ",");
		Результат = Результат + СимволРазделителя + Элемент.Ключ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает имя файла с расширением. Если расширение пустое, точка не добавляется.
//
// Параметры:
//  ИмяБезРасширения - Строка - имя файла без расширения.
//  Расширение - Строка - расширение файла (без точки).
//
// Возвращаемое значение:
//  Строка - имя файла с расширением.
//
Функция ПолучитьИмяСРасширением(ИмяБезРасширения, Расширение) Экспорт
	Если ПустаяСтрока(Расширение) Тогда
		Возврат ИмяБезРасширения;
	КонецЕсли;
	Возврат ИмяБезРасширения + "." + Расширение;
КонецФункции

// Раскладывает полное имя файла на составляющие (путь, имя, расширение и т.п.).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Структура - составные части полного имени файла (Путь, ИмяБезРасширения, Расширение и т.п.).
//
Функция РазложитьПолноеИмяФайла(ПолноеИмя) Экспорт
	СтруктураИмениФайла = Новый Структура("ПолноеИмя,Путь,Имя,Расширение,ИмяБезРасширения");
	ЗаполнитьЗначенияСвойств(СтруктураИмениФайла, Новый Файл(ПолноеИмя));
	Если СтруктураИмениФайла.Путь = ПолучитьРазделительПути() Тогда
		СтруктураИмениФайла.Путь = "";
	КонецЕсли;
	Возврат СтруктураИмениФайла;
КонецФункции

// Дополняет соответствие-приёмник значениями из другого соответствия-источника.
//
// Параметры:
//  Приемник - Соответствие - коллекция, в которую добавляются новые значения.
//  Источник - Соответствие - коллекция, из которой считываются пары Ключ и Значение.
//  Заменять - Булево, Неопределено - поведение при пересечении ключей: Истина - заменять, Ложь - пропускать,
//   Неопределено - бросать исключение при пересечении.
//
Процедура ДополнитьСоответствие(Приемник, Источник, Заменять = Неопределено) Экспорт
	Для Каждого Элемент Из Источник Цикл
		Если Заменять <> Истина И Приемник[Элемент.Ключ] <> Неопределено Тогда
			Если Заменять = Ложь Тогда
				Продолжить;
			Иначе
				ВызватьИсключение СтрШаблон(
					НСтр("ru = 'Пересечение ключей источника и приемника: ""%1"".'"), Элемент.Ключ);
			КонецЕсли;
		КонецЕсли;
		Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
КонецПроцедуры

// Преобразует расширение файла в нижний регистр без точки.
//
// Параметры:
//  Расширение - Строка - расширение файла (с точкой или без).
//
// Возвращаемое значение:
//  Строка - расширение без точки.
//
Функция РасширениеБезТочки(Расширение) Экспорт
	Расширение = НРег(СокрЛП(Расширение));
	Если Сред(Расширение, 1, 1) = "." Тогда
		Расширение = Сред(Расширение, 2);
	КонецЕсли;
	Возврат Расширение;
КонецФункции

// Выделяет из имени файла его расширение (набор символов после последней точки).
//
// Параметры:
//  Имя - Строка - имя файла (с расширением).
//
// Возвращаемое значение:
//  Строка - расширение файла без точки.
//
Функция ПолучитьРасширениеИмениФайла(Имя) Экспорт
	РасширениеФайла = "";
	МассивСтрок = СтрРазделить(Имя, ".", Ложь);
	Если МассивСтрок.Количество() > 1 Тогда
		РасширениеФайла = МассивСтрок[МассивСтрок.Количество() - 1];
	КонецЕсли;
	Возврат РасширениеФайла;
КонецФункции

// Дополняет массив-приёмник значениями из массива-источника.
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения.
//  МассивИсточник - Массив - массив значений для заполнения.
//  ТолькоУникальныеЗначения - Булево - если Истина, добавляются только уникальные значения.
//
Процедура ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоУникальныеЗначения = Ложь) Экспорт
	Если ТолькоУникальныеЗначения Тогда
		УникальныеЗначения = Новый Соответствие;
		Для Каждого Значение Из МассивПриемник Цикл
			УникальныеЗначения.Вставить(Значение, Истина);
		КонецЦикла;
		Для Каждого Значение Из МассивИсточник Цикл
			Если УникальныеЗначения[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				УникальныеЗначения.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Возвращает значение свойства структуры (или значение по умолчанию, если свойства нет).
// Используется также внутри ДополнитьСтруктуру.
//
// Параметры:
//  Структура - Структура - структура, в которой проверяется наличие свойства.
//  Ключ - Строка - имя свойства.
//  ЗначениеПоУмолчанию - Произвольный - значение, возвращаемое, если свойства нет в структуре.
//
// Возвращаемое значение:
//  Произвольный - значение свойства либо ЗначениеПоУмолчанию.
//
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Результат = ЗначениеПоУмолчанию;
	Если Структура.Свойство(Ключ, Результат) Тогда
		Возврат Результат;
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
КонецФункции

// Составляет полное имя файла из имени каталога и имени файла.
//
// Параметры:
//  Каталог - Строка - путь к каталогу.
//  Имя - Строка - имя файла.
//
// Возвращаемое значение:
//  Строка - полное имя файла (каталог + имя).
//
Функция ПолучитьПолноеИмяФайла(Каталог, Имя) Экспорт
	Если ПустаяСтрока(Имя) Тогда
		Возврат Каталог;
	КонецЕсли;
	РазделительПути = "";
	Если (Прав(Каталог, 1) <> "\") И (Прав(Каталог, 1) <> "/") Тогда
		РазделительПути = ?(СтрНайти(Каталог, "\") = 0, "/", "\");
	КонецЕсли;
	Возврат Каталог + РазделительПути + Имя;
КонецФункции

// Обёртка РаботаСФайламиСлужебныйКлиентСервер.ИндексПиктограммыФайла.
//
// Параметры:
//  Расширение - Строка - расширение файла.
//
// Возвращаемое значение:
//  Число - индекс картинки файла в коллекции пиктограмм файлов.
//
Функция ИндексПиктограммыФайла(Расширение) Экспорт
	Возврат ОбщийМодуль("РаботаСФайламиСлужебныйКлиентСервер").ИндексПиктограммыФайла(Расширение);
КонецФункции

// Преобразует исходную строку в число без вызова исключений.
//
// Параметры:
//  Строка - Строка - строка, которую необходимо привести к числу.
//
// Возвращаемое значение:
//  Число, Неопределено - полученное число, либо Неопределено, если строка не является числом.
//
Функция СтрокаВЧисло(Строка) Экспорт
	ЗначениеСтроки = СтрЗаменить(Строка, " ", "");
	Если СтрНачинаетсяС(ЗначениеСтроки, "(") Тогда
		ЗначениеСтроки = СтрЗаменить(ЗначениеСтроки, "(", "-");
		ЗначениеСтроки = СтрЗаменить(ЗначениеСтроки, ")", "");
	КонецЕсли;
	СтрокаБезНулей = СтрЗаменить(ЗначениеСтроки, "0", "");
	Если ПустаяСтрока(СтрокаБезНулей) Или СтрокаБезНулей = "-" Тогда
		Возврат 0;
	КонецЕсли;
	ТипЧисло = Новый ОписаниеТипов("Число");
	Результат = ТипЧисло.ПривестиЗначение(ЗначениеСтроки);
	Возврат ?(Результат <> 0 И Не ПустаяСтрока(СтрокаБезНулей), Результат, Неопределено);
КонецФункции

// Разбивает строку на несколько подстрок по указанному разделителю (разделитель может быть любой длины).
//
// Параметры:
//  Значение - Строка - текст с разделителями.
//  Разделитель - Строка - разделитель строк текста.
//  ПропускатьПустыеСтроки - Булево, Неопределено - признак необходимости включения в результат пустых строк.
//  СокращатьНепечатаемыеСимволы - Булево - сокращать непечатаемые символы по краям каждой из подстрок.
//
// Возвращаемое значение:
//  Массив из Строка - массив подстрок.
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Значение, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено,
	СокращатьНепечатаемыеСимволы = Ложь) Экспорт

	Если СтрДлина(Разделитель) = 1
		И ПропускатьПустыеСтроки = Неопределено
		И СокращатьНепечатаемыеСимволы Тогда
		Возврат РазложитьСтрокуБыстрымРазделением(Значение, Разделитель);
	КонецЕсли;

	Результат = Новый Массив;

	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Значение) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Если СтрДлина(Разделитель) = 0 Тогда
		Возврат РазложитьСтрокуБезРазделителя(Значение, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы);
	КонецЕсли;

	Возврат РазложитьСтрокуПоРазделителю(Значение, Разделитель, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Быстрый путь разложения строки: разделитель длиной 1 символ, без спецрежимов совместимости.
// Вспомогательный метод РазложитьСтрокуВМассивПодстрок.
//
// Параметры:
//  Значение - Строка - текст с разделителями.
//  Разделитель - Строка - разделитель строк текста, длина ровно 1 символ.
//
// Возвращаемое значение:
//  Массив из Строка - массив подстрок.
//
Функция РазложитьСтрокуБыстрымРазделением(Значение, Разделитель)
	Результат = СтрРазделить(Значение, Разделитель, Ложь);
	Для Индекс = 0 По Результат.ВГраница() Цикл
		Результат[Индекс] = СокрЛП(Результат[Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разложение строки при пустом разделителе - строка возвращается одним элементом (либо пустым массивом).
// Вспомогательный метод РазложитьСтрокуВМассивПодстрок.
//
// Параметры:
//  Значение - Строка - исходная строка.
//  ПропускатьПустыеСтроки - Булево - признак необходимости включения в результат пустых строк.
//  СокращатьНепечатаемыеСимволы - Булево - сокращать непечатаемые символы по краям строки.
//
// Возвращаемое значение:
//  Массив из Строка - массив из одного элемента либо пустой массив.
//
Функция РазложитьСтрокуБезРазделителя(Значение, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы)
	Результат = Новый Массив;
	Если ПропускатьПустыеСтроки И ПустаяСтрока(Значение) Тогда
		Возврат Результат;
	КонецЕсли;
	Если СокращатьНепечатаемыеСимволы Тогда
		Значение = СокрЛП(Значение);
	КонецЕсли;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

// Разложение строки по разделителю произвольной длины с фильтрацией пустых подстрок.
// Вспомогательный метод РазложитьСтрокуВМассивПодстрок.
//
// Параметры:
//  Значение - Строка - текст с разделителями.
//  Разделитель - Строка - разделитель строк текста.
//  ПропускатьПустыеСтроки - Булево - признак необходимости включения в результат пустых строк.
//  СокращатьНепечатаемыеСимволы - Булево - сокращать непечатаемые символы по краям каждой из подстрок.
//
// Возвращаемое значение:
//  Массив из Строка - массив подстрок.
//
Функция РазложитьСтрокуПоРазделителю(Значение, Разделитель, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы)
	Результат = Новый Массив;
	Позиция = СтрНайти(Значение, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Значение, Позиция - 1);
		ДобавитьПодстрокуВРезультат(Результат, Подстрока, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы);
		Значение = Сред(Значение, Позиция + СтрДлина(Разделитель));
		Позиция = СтрНайти(Значение, Разделитель);
	КонецЦикла;
	ДобавитьПодстрокуВРезультат(Результат, Значение, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы);
	Возврат Результат;
КонецФункции

// Добавляет подстроку в результат с учётом фильтрации пустых строк и сокращения непечатаемых символов.
// Вспомогательный метод РазложитьСтрокуПоРазделителю.
//
// Параметры:
//  Результат - Массив из Строка - массив, в который добавляется подстрока.
//  Подстрока - Строка - подстрока-кандидат на добавление.
//  ПропускатьПустыеСтроки - Булево - признак необходимости включения в результат пустых строк.
//  СокращатьНепечатаемыеСимволы - Булево - сокращать непечатаемые символы по краям подстроки.
//
Процедура ДобавитьПодстрокуВРезультат(Результат, Подстрока, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы)
	Если ПропускатьПустыеСтроки И ПустаяСтрока(Подстрока) Тогда
		Возврат;
	КонецЕсли;
	Если СокращатьНепечатаемыеСимволы Тогда
		Подстрока = СокрЛП(Подстрока);
	КонецЕсли;
	Результат.Добавить(Подстрока);
КонецПроцедуры

#КонецОбласти
