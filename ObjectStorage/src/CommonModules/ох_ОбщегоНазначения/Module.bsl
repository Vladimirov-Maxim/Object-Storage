#Область ЯдроОстрова

// Возвращает признак использования БСП (наличия подсистемы "СтандартныеПодсистемы.БазоваяФункциональность").
// Кешируется в ох_ОбъектноеХранилищеПовтИсп - образец ОбщегоНазначенияБПО.ИспользуетсяБСП.
//
// Возвращаемое значение:
//  Булево - Истина, если в конфигурации есть подсистема БСП.
//
Функция ИспользуетсяБСП() Экспорт
	Возврат ох_ОбъектноеХранилищеПовтИсп.ИспользуетсяБСП();
КонецФункции

// Возвращает признак наличия указанной подсистемы БСП. Есть БСП - делегирует ОбщегоНазначения.ПодсистемаСуществует,
// нет БСП - Ложь. Образец - ОбщегоНазначенияБПО.ПодсистемаСуществует.
//
// Параметры:
//  ПолноеИмяПодсистемы - Строка - полное имя подсистемы, например "СтандартныеПодсистемы.РаботаСФайлами".
//
// Возвращаемое значение:
//  Булево - Истина, если подсистема присутствует в конфигурации.
//
Функция ПодсистемаСуществует(ПолноеИмяПодсистемы) Экспорт
	Возврат ох_ОбъектноеХранилищеПовтИсп.ПодсистемаДоступна(ПолноеИмяПодсистемы);
КонецФункции

// Возвращает общий модуль БСП по имени (делегирование строкой, без прямой ссылки на модуль в коде).
// Образец - ОбщегоНазначения.ОбщийМодуль (внутри - Вычислить(Имя), не ВычислитьВБезопасномРежиме).
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  ОбщийМодуль - найденный общий модуль.
//
Функция ОбщийМодуль(Имя) Экспорт

	Модуль = Вычислить(Имя);

	Если ТипЗнч(Модуль) <> Тип("ОбщийМодуль") Тогда
		ВызватьИсключение ТекстОшибкиНедоступенМодуль(Имя);
	КонецЕсли;

	Возврат Модуль;

КонецФункции

// Возвращает признак наличия общего модуля с указанным именем (для модулей вне подсистем БСП, например
// КоннекторHTTP). Кешируется в ох_ОбъектноеХранилищеПовтИсп.
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  Булево - Истина, если общий модуль присутствует в конфигурации.
//
Функция МодульДоступен(Имя) Экспорт
	Возврат ох_ОбъектноеХранилищеПовтИсп.МодульДоступен(Имя);
КонецФункции

// Формирует человекочитаемый текст исключения об отсутствии общего модуля.
//
// Параметры:
//  Имя - Строка - имя недостающего общего модуля.
//
// Возвращаемое значение:
//  Строка - текст исключения.
//
Функция ТекстОшибкиНедоступенМодуль(Имя) Экспорт
	Возврат ох_ОбщегоНазначенияКлиентСервер.ТекстОшибкиНедоступнаЗависимость(Имя, "общий модуль");
КонецФункции

