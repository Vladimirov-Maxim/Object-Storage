	Возврат РегистрыСведений.ох_ЗаданияДляОбработкиОбъектовХранилища;
КонецФункции

Функция МенеджерХранилища() Экспорт
	Возврат РегистрыСведений.ох_ПрисоединенныеФайлыВХранилище;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияПроверкаПараметров

Функция НовыйДанныеПрисоединенногоФайла()
	
	ДанныеПрисоединенногоФайла = Новый Структура;
	ДанныеПрисоединенногоФайла.Вставить("Ссылка");
	ДанныеПрисоединенногоФайла.Вставить("Расширение");
	ДанныеПрисоединенногоФайла.Вставить("ВладелецФайла");
	ДанныеПрисоединенногоФайла.Вставить("Наименование");
	ДанныеПрисоединенногоФайла.Вставить("ДатаМодификацииУниверсальная");
	ДанныеПрисоединенногоФайла.Вставить("ПометкаУдаления");
	
	Возврат ДанныеПрисоединенногоФайла;
	
КонецФункции

Функция ПараметрыВыполненияОперации(ПараметрыРаботыОбъектногоХранилища, ДанныеОперации)
	
	ЗаполнитьПараметрыРаботыОбъектногоХранилища(ПараметрыРаботыОбъектногоХранилища);
	ЗаполнитьДанныеПрисоединенногоФайла(ДанныеОперации.ДанныеФайла);
	
	ДанныеФайла = ох_ОбщегоНазначения.СкопироватьРекурсивно(ДанныеОперации.ДанныеФайла);

	ДополнительныеПараметры = Новый Структура;
	Для Каждого Параметр Из ДанныеОперации Цикл
		Если Параметр.Ключ = "ДанныеФайла" Тогда
			Продолжить;
		КонецЕсли;
		ДополнительныеПараметры.Вставить(Параметр.Ключ, ох_ОбщегоНазначения.СкопироватьРекурсивно(Параметр.Значение));
	КонецЦикла;
	
	ДанныеФайлаХранилища = Новый Структура;
	ДанныеФайлаХранилища.Вставить("КлючОбъекта", КлючОбъекта(ДанныеОперации.ДанныеФайла));
	
	РезультатОперации = Новый Структура;
	РезультатОперации.Вставить("Ошибка"         , Ложь);
	РезультатОперации.Вставить("Результат"      , Истина);
	РезультатОперации.Вставить("СообщениеОшибки", "");
	
	ПараметрыВыполненияОперации = Новый Структура;
	ПараметрыВыполненияОперации.Вставить("ДанныеФайла"                       , ДанныеФайла);
	ПараметрыВыполненияОперации.Вставить("ДанныеФайлаХранилища"              , ДанныеФайлаХранилища);
	ПараметрыВыполненияОперации.Вставить("ДополнительныеПараметры"           , ДополнительныеПараметры);
	ПараметрыВыполненияОперации.Вставить("ПараметрыРаботыОбъектногоХранилища", ПараметрыРаботыОбъектногоХранилища);
	ПараметрыВыполненияОперации.Вставить("РезультатОперации"                 , РезультатОперации);
	
	Возврат ПараметрыВыполненияОперации;
	
КонецФункции

Процедура ЗаполнитьПараметрыРаботыОбъектногоХранилища(ПараметрыРаботыОбъектногоХранилища)
	
	ЗаполнитьНастройкиСервисногоАккаунта(ПараметрыРаботыОбъектногоХранилища);
	ЗаполнитьДанныеБакета(ПараметрыРаботыОбъектногоХранилища);
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиСервисногоАккаунта(ПараметрыРаботыОбъектногоХранилища)
	
	СервисныйАккаунт = ПараметрыРаботыОбъектногоХранилища.СервисныйАккаунт;
	Если Не ЗначениеЗаполнено(СервисныйАккаунт) Тогда
		СервисныйАккаунт = СервисныйАккаунтПоУмолчанию();
	КонецЕсли;
	
	ох_ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ох_ОбъектноеХранилище.ЗаполнитьНастройкиСервисногоАккаунта",
		"СервисныйАккаунт",
		СервисныйАккаунт,
		Тип("СправочникСсылка.ох_СервисныеАккаунтыОбъектныхХранилищ"));
		
	Если Не ЗначениеЗаполнено(СервисныйАккаунт) Тогда
		ВызватьИсключение "Не заполнен сервисный аккаунт.";
	КонецЕсли;
	
	НастройкиСервисногоАккаунта = НастройкиСервисногоАккаунта(СервисныйАккаунт);
	
	Если Не НастройкиСервисногоАккаунта.Использовать Тогда
		ВызватьИсключение СтрШаблон(
			"Сервисный аккаунт %1 не используется для интеграции. Необходимо установить флаг ""Использовать"".",
			НастройкиСервисногоАккаунта.Представление);
	КонецЕсли;
	
	Эталон    = Справочники.ох_СервисныеАккаунтыОбъектныхХранилищ.НовыйНастройкиСервисногоАккаунта();
	Сообщение = "Ошибка настроек сервисного аккаунта";
	ПроверитьВходныеПараметры(НастройкиСервисногоАккаунта, Эталон, Сообщение);
	
	ПараметрыРаботыОбъектногоХранилища.Вставить("СервисныйАккаунт"           , СервисныйАккаунт);
	ПараметрыРаботыОбъектногоХранилища.Вставить("НастройкиСервисногоАккаунта", НастройкиСервисногоАккаунта);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеБакета(ПараметрыРаботыОбъектногоХранилища)
	
	Бакет = ПараметрыРаботыОбъектногоХранилища.Бакет;
	Если Не ЗначениеЗаполнено(Бакет) Тогда
		Бакет = БакетПоУмолчанию();
	КонецЕсли;
	
	ох_ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ох_ОбъектноеХранилище.ЗаполнитьДанныеБакета",
		"Бакет",
		Бакет,
		Тип("СправочникСсылка.ох_БакетыОбъектныхХранилищ"));
		
	Если Не ЗначениеЗаполнено(Бакет) Тогда
		ВызватьИсключение "Не заполнен бакет хранилища.";
	КонецЕсли;
	
	ДанныеБакета = ДанныеБакета(Бакет);
	
	Эталон    = Справочники.ох_БакетыОбъектныхХранилищ.НовыйОписаниеБакета();
	Сообщение = "Некорректное описание бакета";
	ПроверитьВходныеПараметры(ДанныеБакета, Эталон, Сообщение);
	
	ПараметрыРаботыОбъектногоХранилища.Вставить("Бакет"       , Бакет);
	ПараметрыРаботыОбъектногоХранилища.Вставить("ДанныеБакета", ДанныеБакета);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПрисоединенногоФайла(ДанныеПрисоединенногоФайл)
	
	ПрисоединенныйФайл = ДанныеПрисоединенногоФайл.Ссылка;
	
	ох_ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ох_ОбъектноеХранилище.ЗаполнитьДанныеПрисоединенногоФайла",
		"ПрисоединенныйФайл",
		ПрисоединенныйФайл,
		Метаданные.ОпределяемыеТипы.ох_ПрисоединенныеФайлыОбъектногоХранилища.Тип);
	
	Если Не ЗначениеЗаполнено(ПрисоединенныйФайл) Тогда
		ВызватьИсключение "Не заполнен присоединенный файл.";
	КонецЕсли;
	
	ЗаполнитьДанныеФайла(ДанныеПрисоединенногоФайл, ПрисоединенныйФайл);
	
	КонтрольнаяСумма = КонтрольнаяСуммаФайлаХранилища(ДанныеПрисоединенногоФайл);
	ДанныеПрисоединенногоФайл.Вставить("КонтрольнаяСумма", КонтрольнаяСумма);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеФайла(ДанныеПрисоединенногоФайл, ПрисоединенныйФайл)
	
	ПолучатьДанныеФайла = Ложь;
	
	СвойствоДвоичныеДанныеФайла = "ДвоичныеДанныеФайла";
	ПолучатьДвоичныеДанныеФайла = ДанныеПрисоединенногоФайл.Свойство(СвойствоДвоичныеДанныеФайла)
		И Не ЗначениеЗаполнено(ДанныеПрисоединенногоФайл[СвойствоДвоичныеДанныеФайла]);
	
	Для Каждого СвойствоФайла Из ДанныеПрисоединенногоФайл Цикл
		Если СвойствоФайла.Ключ <> СвойствоДвоичныеДанныеФайла
			И Не ЗначениеЗаполнено(СвойствоФайла.Значение) Тогда
			ПолучатьДанныеФайла = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПолучатьДанныеФайла
		И ПолучатьДвоичныеДанныеФайла Тогда
		
		ПараметрыПолученияДанныхФайлов = ох_ОбщегоНазначения.ПараметрыДанныхФайла();

		ПараметрыПолученияДанныхФайлов.ИдентификаторФормы = Новый УникальныйИдентификатор;
		ПараметрыПолученияДанныхФайлов.ВызыватьИсключение = Истина;
		ПараметрыПолученияДанныхФайлов.ПолучатьСсылкуНаДвоичныеДанные = ПолучатьДвоичныеДанныеФайла;

		ДанныеФайла = ох_ОбщегоНазначения.ДанныеФайла(ПрисоединенныйФайл, ПараметрыПолученияДанныхФайлов);
		ох_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеПрисоединенногоФайл, ДанныеФайла, "ЗаменятьПустые");
		
		Если ДанныеПрисоединенногоФайл.Свойство("ВладелецФайла")
			И Не ЗначениеЗаполнено(ДанныеПрисоединенногоФайл.ВладелецФайла) Тогда
			ДанныеПрисоединенногоФайл.ВладелецФайла = ДанныеФайла.Владелец;
		КонецЕсли;
		
		Если ПолучатьДвоичныеДанныеФайла Тогда
			ДанныеПрисоединенногоФайл.ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(
				ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		КонецЕсли;
		
	ИначеЕсли ПолучатьДанныеФайла Тогда
		
		Свойства    = ох_ОбщегоНазначенияКлиентСервер.КлючиСтруктурыВСтроку(ДанныеПрисоединенногоФайл);
		ДанныеФайла = ох_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПрисоединенныйФайл, Свойства);
		ох_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеПрисоединенногоФайл, ДанныеФайла, "ЗаменятьПустые");
		
	ИначеЕсли ПолучатьДвоичныеДанныеФайла Тогда
		
		ДанныеПрисоединенногоФайл.ДвоичныеДанныеФайла = ох_ОбщегоНазначения.ДвоичныеДанныеФайла(ПрисоединенныйФайл);

	Иначе
		// Ни данные файла, ни двоичные данные не запрошены - ничего не получаем.
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВходныеПараметры(Знач ВходныеПараметры, Эталон, Сообщение)
	
	СообщенияОбОшибках = Новый Массив;
	
	ПроверитьВходныеПараметрыРекурсивно(ВходныеПараметры, Эталон, Сообщение, СообщенияОбОшибках);
	
	Если СообщенияОбОшибках.Количество() Тогда
		
		РазделительСообщений = Символы.ПС + Символы.Таб;
		
		ВызватьИсключение СтрШаблон(
			"%1:%2%3",
			Сообщение,
			РазделительСообщений,
			СтрСоединить(СообщенияОбОшибках, РазделительСообщений));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВходныеПараметрыРекурсивно(Знач ВходныеПараметры, Эталон, Сообщение, СообщенияОбОшибках)
	
	Для Каждого Параметр Из Эталон Цикл
		
		Имя          = Параметр.Ключ;
		Значение     = Параметр.Значение;
		ТипПараметра = ТипЗнч(Значение);
		
		Если Не ВходныеПараметры.Свойство(Имя) Тогда
			ТекстСообщения = СтрШаблон("Не указан обязательный параметр %1", Имя);
		ИначеЕсли ТипЗнч(ВходныеПараметры[Имя]) <> ТипПараметра Тогда
			ТекстСообщения = СтрШаблон("Тип параметры %1 не соответствует ожидаемому типу %2", Имя, Строка(ТипПараметра));
		ИначеЕсли ТипПараметра <> Тип("Булево")
			И Не ЗначениеЗаполнено(ВходныеПараметры[Имя]) Тогда
			ТекстСообщения = СтрШаблон("Не заполнен обязательный параметр %1", Имя);
		ИначеЕсли ТипПараметра = Тип("Структура") Тогда
			ПроверитьВходныеПараметрыРекурсивно(ВходныеПараметры[Имя], Значение, Сообщение, СообщенияОбОшибках);
			Продолжить;
		Иначе
			Продолжить;
		КонецЕсли;
		
		СообщенияОбОшибках.Добавить(ТекстСообщения);
		
	КонецЦикла;
	
КонецПроцедуры

Функция КонтрольнаяСуммаФайлаХранилища(ДанныеФайла)
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	
	Хеш.Добавить(ДанныеФайла.Наименование);
	Хеш.Добавить(ДанныеФайла.Расширение);
	Хеш.Добавить(XMLСтрока(ДанныеФайла.ДатаМодификацииУниверсальная));
	
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма);
	
КонецФункции

#КонецОбласти

#Область РаботаСКоннектором

Процедура ДобавитьНаименованиеФайлаВМетаданные(ПараметрыВыполненияОперации)
	
	НаименованиеФайла = ПараметрыВыполненияОперации.ДанныеФайла.Наименование;
	РасширениеФайла   = ПараметрыВыполненияОперации.ДанныеФайла.Расширение;
	
	ИмяФайла = ИмяФайла(НаименованиеФайла, РасширениеФайла);
	
	ПараметрыВыполненияОперации.ДополнительныеПараметры.МетаданныеФайла.Вставить("name", ИмяФайла);
	
КонецПроцедуры

Функция КлючОбъекта(ДанныеФайла)
	
	ПолноеИмяБезРасширения = СтрШаблон(
		"1C/%1/%2",
		XMLСтрока(ДанныеФайла.ВладелецФайла),
		XMLСтрока(ДанныеФайла.Ссылка));
	
	КлючОбъекта = ох_ОбщегоНазначенияКлиентСервер.ПолучитьИмяСРасширением(ПолноеИмяБезРасширения, ДанныеФайла.Расширение);
	
	Возврат КлючОбъекта;
	
КонецФункции

Процедура ЗаполнитьРезультатОперации(ПараметрыВыполненияОперации, ОтветКоннектора)
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(ОтветКоннектора.КодСостояния);
	Сообщения.Добавить(ОтветКоннектора.URL);
	Сообщения.Добавить(ОтветКоннектора.КлассификацияОшибки);
	Сообщения.Добавить(ОтветКоннектора.Сообщение);
	
	ТекстОшибки = СтрСоединить(Сообщения, Символы.ПС);
	
	ПараметрыВыполненияОперации.РезультатОперации.Ошибка          = ОтветКоннектора.Ошибка;
	ПараметрыВыполненияОперации.РезультатОперации.Результат       = ОтветКоннектора.Результат;
	ПараметрыВыполненияОперации.РезультатОперации.СообщениеОшибки = ТекстОшибки;
	
КонецПроцедуры

#КонецОбласти

#Область ПрисоединенныеФайлыХранилища

Процедура ЗаписатьДанныеФайла(ДанныеПомещенногоФайла, ДанныеСсылки = Неопределено)
	МенеджерХранилища().ЗаписатьФайлХранилища(ЗаписьФайлаХранилища(ДанныеПомещенногоФайла, ДанныеСсылки));
КонецПроцедуры

Процедура УдалитьДанныеФайла(ДанныеУдаленногоФайла)
	МенеджерХранилища().УдалитьФайлХранилища(ЗаписьФайлаХранилища(ДанныеУдаленногоФайла));
КонецПроцедуры

Функция ЗаписьФайлаХранилища(ДанныеПомещенногоФайла, ДанныеСсылки = Неопределено)
	
	ЗаписьФайлаХранилища = МенеджерХранилища().НовыйДанныеФайлаХранилища();
	
	ЗаписьФайлаХранилища.Файл             = ДанныеПомещенногоФайла.ДанныеФайла.Ссылка;
	ЗаписьФайлаХранилища.ВладелецФайла    = ДанныеПомещенногоФайла.ДанныеФайла.ВладелецФайла;
	ЗаписьФайлаХранилища.СервисныйАккаунт = ДанныеПомещенногоФайла.ПараметрыРаботыОбъектногоХранилища.СервисныйАккаунт;
	ЗаписьФайлаХранилища.Бакет            = ДанныеПомещенногоФайла.ПараметрыРаботыОбъектногоХранилища.Бакет;
	ЗаписьФайлаХранилища.КлючОбъекта      = ДанныеПомещенногоФайла.ДанныеФайлаХранилища.КлючОбъекта;
	ЗаписьФайлаХранилища.КонтрольнаяСумма = ДанныеПомещенногоФайла.ДанныеФайла.КонтрольнаяСумма;
	
	Если ДанныеСсылки <> Неопределено Тогда
		ЗаписьФайлаХранилища.СсылкаФайлаХранилища.ДатаНачалаДействияСсылки    = ДанныеСсылки.ДатаНачалаДействия;
		ЗаписьФайлаХранилища.СсылкаФайлаХранилища.ДатаОкончанияДействияСсылки = ДанныеСсылки.ДатаОкончанияДействия;
		ЗаписьФайлаХранилища.СсылкаФайлаХранилища.Ссылка                      = ДанныеСсылки.Ссылка;
	КонецЕсли;
	
	Возврат ЗаписьФайлаХранилища;
	
КонецФункции

Функция ТребуетсяВыгрузкаФайла(ПараметрыВыполненияОперации)
	
	ДанныеФайла = ПараметрыВыполненияОперации.ДанныеФайла;
	ПараметрыРаботыОбъектногоХранилища = ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища;
	
	ДанныеФайлаХранилища = ИнформацияФайлаХранилища(
		ДанныеФайла.Ссылка, ПараметрыРаботыОбъектногоХранилища, ДанныеФайла.ВладелецФайла);
	
	Возврат ДанныеФайлаХранилища = Неопределено
		Или ДанныеФайлаХранилища.КонтрольнаяСумма <> ДанныеФайла.КонтрольнаяСумма;
	
КонецФункции

Функция ВремяЖизниСсылки(КоличествоДней = 7) Экспорт
	Возврат КоличествоДней * 86400;
КонецФункции

#КонецОбласти

#Область ЗаданияДляОбработкиФайловХранилища

Процедура СоздатьЗаданиеНаВыгрузку(
	ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, Знач ВладелецФайла = Неопределено)
	
	Если Не ЗначениеЗаполнено(ВладелецФайла) Тогда
		ВладелецФайла = ох_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПрисоединенныйФайл, "ВладелецФайла");
	КонецЕсли;
	
	Если Не РегистрироватьФайл(ВладелецФайла) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаданий().СоздатьЗаданиеНаВыгрузкуФайла(
		ПараметрыРегистрацииФайлаДляОбработки(ПрисоединенныйФайл, ВладелецФайла, ПараметрыРаботыОбъектногоХранилища));
	
КонецПроцедуры

Процедура СоздатьЗаданиеНаУдаление(
	ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, Знач ВладелецФайла = Неопределено)
	
	Если Не ЗначениеЗаполнено(ВладелецФайла) Тогда
		ВладелецФайла = ох_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПрисоединенныйФайл, "ВладелецФайла");
	КонецЕсли;
	
	Если Не РегистрироватьФайл(ВладелецФайла) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаданий().СоздатьЗаданиеНаУдалениеФайла(
		ПараметрыРегистрацииФайлаДляОбработки(ПрисоединенныйФайл, ВладелецФайла, ПараметрыРаботыОбъектногоХранилища));
	
КонецПроцедуры

Функция ПараметрыРегистрацииФайлаДляОбработки(ПрисоединенныйФайл, ВладелецФайла, ПараметрыРаботыОбъектногоХранилища)
	
	ПараметрыРегистрации = МенеджерЗаданий().НовыйПараметрыСозданияЗаданияДляОбработкиФайла();
	
	ПараметрыРегистрации.Файл             = ПрисоединенныйФайл;
	ПараметрыРегистрации.ВладелецФайла    = ВладелецФайла;
	ПараметрыРегистрации.СервисныйАккаунт = ПараметрыРаботыОбъектногоХранилища.СервисныйАккаунт;
	ПараметрыРегистрации.Бакет            = ПараметрыРаботыОбъектногоХранилища.Бакет;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция РегистрироватьФайл(ВладелецФайла)
	
	Если ЗначениеЗаполнено(ВладелецФайла) Тогда
		
		ОпределяемыйТипВладельцев = Метаданные.ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища;
		
		Если Не ОпределяемыйТипВладельцев.Тип.СодержитТип(ТипЗнч(ВладелецФайла)) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

Функция ИмяФайла(Наименование, Расширение)
	
	ЧастиНаименования = ох_ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Наименование);
	ИмяФайла = ох_ОбщегоНазначенияКлиентСервер.ПолучитьИмяСРасширением(ЧастиНаименования.ИмяБезРасширения, Расширение);
	
	Возврат ИмяФайла;
	
КонецФункции

#КонецОбласти