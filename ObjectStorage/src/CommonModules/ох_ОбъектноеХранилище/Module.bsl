// Начальная настройка модуля.
//
// Возвращаемое значение:
//  Структура:
//   * СервисныйАккаунт - СправочникСсылка.ох_СервисныеАккаунтыОбъектныхХранилищ - сервисный аккаунт.
//   * Бакет - СправочникСсылка.ох_БакетыОбъектныхХранилищ - бакет хранилища.
//   * Сессия - Структура - см. ох_КоннекторS3.НоваяСессия
//
Функция НовыйПараметрыРаботыСОбъектнымХранилищем() Экспорт
	
	ПараметрыРаботыСОбъектнымХранилище = Новый Структура;
	
	ПараметрыРаботыСОбъектнымХранилище.Вставить("СервисныйАккаунт", СервисныйАккаунтПоУмолчанию());
	ПараметрыРаботыСОбъектнымХранилище.Вставить("Бакет"           , БакетПоУмолчанию());
	ПараметрыРаботыСОбъектнымХранилище.Вставить("Сессия");
	
	Возврат ПараметрыРаботыСОбъектнымХранилище;
	
КонецФункции

#КонецОбласти

#Область ОбслуживаниеДанныхПодсистемы

// Выполняет регламентные операции с объектами хранилища.
//
// Удаляет записи из регистра заданий исходя из количества дней хранения записей. См. ОчиститьДанныеЗаданий.
// Удаляет файлы из хранилища исходя из количества дней хранения файлов. См. УдалитьФайлыПоСрокуХранения.
// Актуализация ссылок файлов в объектном хранилище. См. ОбновитьСсылкиФайлов.
//
Процедура ВыполнитьРегламентныеОперацииОбъектногоХранилища() Экспорт
	
	ОчиститьДанныеЗаданий(КоличествоДнейХраненияЗаданий());
	
	УдалитьФайлыПоСрокуХранения(КоличествоДнейХраненияФайлов());
	ВыполнитьЗадания();
	
	ОбновитьСсылкиФайлов();
	
КонецПроцедуры

#КонецОбласти

#Область МенеджерЗаданий

// Регистрирует файлы для выгрузки в хранилище.
//
// Параметры:
//  Присоединенныефайлы - Массив из ОпределяемыеТипы.ПрисоединенныйФайл - присоединенные файлы.
//  ПараметрыРаботыОбъектногоХранилища - Структура - см. НовыйПараметрыРаботыСОбъектнымХранилищем.
//  ВладелецФайлов - ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища - владелец файлов.
//
Процедура ЗарегистрироватьФайлыДляВыгрузки(
	Присоединенныефайлы, ПараметрыРаботыОбъектногоХранилища, ВладелецФайлов = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Файл Из Присоединенныефайлы Цикл
		СоздатьЗаданиеНаВыгрузку(Файл, ПараметрыРаботыОбъектногоХранилища, ВладелецФайлов);
	КонецЦикла;
	
КонецПроцедуры

// Регистрирует файлы для удаления из хранилища.
//
// Параметры:
//  Присоединенныефайлы - Массив из ОпределяемыеТипы.ПрисоединенныйФайл - присоединенные файлы.
//  ПараметрыРаботыОбъектногоХранилища - Структура - см. НовыйПараметрыРаботыСОбъектнымХранилищем.
//  ВладелецФайлов - ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища - владелец файлов.
//
Процедура ЗарегистрироватьФайлыДляУдаления(
	Присоединенныефайлы, ПараметрыРаботыОбъектногоХранилища, ВладелецФайлов = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Файл Из Присоединенныефайлы Цикл
		СоздатьЗаданиеНаУдаление(Файл, ПараметрыРаботыОбъектногоХранилища, ВладелецФайлов);
	КонецЦикла;
	
КонецПроцедуры

// Регистрирует файл для выгрузки в хранилище.
//
// Параметры:
//  ПрисоединенныйФайл - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//  ПараметрыРаботыОбъектногоХранилища - Структура - см. НовыйПараметрыРаботыСОбъектнымХранилищем.
//  ВладельцыФайла - Массив из ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища,
//   ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища - владелец(ы) файла, для которых
//   регистрируется задание; если Неопределено, определяется по присоединённому файлу.
//
Процедура ЗарегистрироватьФайлДляВыгрузки(
	ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, ВладельцыФайла = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ВладельцыФайла) = Тип("Массив") Тогда
		
		Для Каждого Владелец Из ВладельцыФайла Цикл
			СоздатьЗаданиеНаВыгрузку(ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, Владелец);
		КонецЦикла;
		
	Иначе
		СоздатьЗаданиеНаВыгрузку(ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, ВладельцыФайла);
	КонецЕсли;
	
КонецПроцедуры

// Регистрирует файл для удаления из хранилища.
//
// Параметры:
//  ПрисоединенныйФайл - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//  ПараметрыРаботыОбъектногоХранилища - Структура - см. НовыйПараметрыРаботыСОбъектнымХранилищем.
//  ВладельцыФайла - Массив из ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища,
//   ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища - владелец(ы) файла, для которых
//   регистрируется задание; если Неопределено, определяется по присоединённому файлу.
//
Процедура ЗарегистрироватьФайлДляУдаления(
	ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, ВладельцыФайла = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ВладельцыФайла) = Тип("Массив") Тогда
		
		Для Каждого Владелец Из ВладельцыФайла Цикл
			СоздатьЗаданиеНаУдаление(ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, Владелец);
		КонецЦикла;
		
	Иначе
		СоздатьЗаданиеНаУдаление(ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, ВладельцыФайла);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет задания из регистра ох_ЗаданияДляОбработкиОбъектовХранилища для обработки файлов хранилища.
//
Процедура ВыполнитьЗадания() Экспорт
	МенеджерЗаданий().ОбработатьЗадания();
КонецПроцедуры

// Удаляет задания исходя из срока хранения.
//
// Параметры:
//  КоличествоДнейХраненияЗаданий - Число - количество дней хранения задания, если 0, тогда задания не удаляются.
//
Процедура ОчиститьДанныеЗаданий(КоличествоДнейХраненияЗаданий) Экспорт
	
	Если ТипЗнч(КоличествоДнейХраненияЗаданий) <> Тип("Число")
		Или КоличествоДнейХраненияЗаданий < 0 Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаданий().ОчиститьДанныеЗаданий(КоличествоДнейХраненияЗаданий);
	
КонецПроцедуры

#КонецОбласти

#Область ХранилищеФайлов

// Возвращает данные файла в объектном хранилище.
//
// Параметры:
//  ПрисоединенныйФайл - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//  ПараметрыРаботыОбъектногоХранилища - Структура - см. НовыйПараметрыРаботыСОбъектнымХранилищем.
//  ВладелецФайла - ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища - владелец файла.
//
// Возвращаемое значение:
//  Неопределено - если файл не выгружен в хранилище.
//  Структура:
//   * КлючОбъекта - Строка - ключ объекта в хранилище.
//   * ДатаИзменения - Дата - последняя дата изменения файла в хранилище.
//   * ДатаНачалаДействияСсылки - Дата - дата начала действия ссылки на файл в хранилище.
//   * ДатаОкончанияДействияСсылки - Дата - дата окончания действия ссылки на файл в хранилище.
//   * Ссылка - Строка - подписанная ссылка на файл в хранилище.
//   * КонтрольнаяСумма - Строка - хеш сумма файла в хранилище,
//                       которая получается из наименования файла, расширения файла и даты модификации файла.
//
Функция ИнформацияФайлаХранилища(
	ПрисоединенныйФайл, ПараметрыРаботыОбъектногоХранилища, ВладелецФайла = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИнформацияФайловХранилища = ИнформацияФайловХранилища(
		ох_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПрисоединенныйФайл),
		ПараметрыРаботыОбъектногоХранилища,
		ВладелецФайла);
		
	Возврат ИнформацияФайловХранилища.Получить(ПрисоединенныйФайл);
	
КонецФункции

// Возвращает данные файлов в объектном хранилище.
//
// Параметры:
//  ПрисоединенныеФайлы - Массив из ОпределяемыеТипы.ПрисоединенныйФайл - присоединенные файлы.
//  ПараметрыРаботыОбъектногоХранилища - Структура - см. НовыйПараметрыРаботыСОбъектнымХранилищем
//  ВладелецФайлов - ОпределяемыеТипы.ох_ВладелецПрисоединенныхФайловОбъектногоХранилища - владелец файлов.
//
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//   * Значение - Структура - см. ИнформацияФайлаХранилища.
//
Функция ИнформацияФайловХранилища(
	ПрисоединенныеФайлы, ПараметрыРаботыОбъектногоХранилища, Знач ВладелецФайлов = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПрисоединенныеФайлы.Количество()
		И Не ЗначениеЗаполнено(ВладелецФайлов) Тогда
		ВладелецФайлов = ох_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПрисоединенныеФайлы[0], "ВладелецФайла");
	КонецЕсли;
	
	ОтборФайлов = Новый Структура;
	ОтборФайлов.Вставить("Файлы"           , ПрисоединенныеФайлы);
	ОтборФайлов.Вставить("ВладелецФайла"   , ВладелецФайлов);
	ОтборФайлов.Вставить("СервисныйАккаунт", ПараметрыРаботыОбъектногоХранилища.СервисныйАккаунт);
	ОтборФайлов.Вставить("Бакет"           , ПараметрыРаботыОбъектногоХранилища.Бакет);
	
	Возврат МенеджерХранилища().ИнформацияОФайлаХранилища(ОтборФайлов);
	
КонецФункции

// Выполняет обновление устаревших ссылок на файлы в хранилище.
// Ссылки обновляются за день до даты окончания срока действия.
//
Процедура ОбновитьСсылкиФайлов() Экспорт
	МенеджерХранилища().ОбновитьСсылкиФайлов();
КонецПроцедуры

// Удаляет файлы из хранилища исходя из срока хранения файлов.
//
// Параметры:
//  КоличествоДнейХраненияФайлов - Число - количество дней хранения файлов, если 0, тогда файлы не удаляются.
//                      срока хранения проверяется по дате изменения в регистре ох_ПрисоединенныеФайлыВХранилище.
Процедура УдалитьФайлыПоСрокуХранения(КоличествоДнейХраненияФайлов) Экспорт
	
	Если ТипЗнч(КоличествоДнейХраненияФайлов) <> Тип("Число")
		Или Не ЗначениеЗаполнено(КоличествоДнейХраненияФайлов) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерХранилища().УдалитьФайлыПоСрокуХранения(КоличествоДнейХраненияФайлов);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСФайлами

#Область ЗагрузкаФайла

// Возвращает набор параметров для загрузки файла.
//
// Возвращаемое значение:
//  Структура:
//   * ДанныеФайла - Структура:
//    ** Ссылка - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//    ** Расширение - Строка - расширение присоединенного файла с точкой.
//    ** ВладелецФайла - ОпределяемыеТипы.ВладелецПрисоединенныхФайлов - владелец файла.
//    ** Наименование - Строка - имя файла.
//    ** ДвоичныеДанныеФайла - ДвоичныеДанные - данные файла для помещения.
//    ** ДатаМодификацииУниверсальная - Дата - дата изменения файла в системе.
//    ** ПометкаУдаления - Булево - пометка удадения файла.
//   * МетаданныеФайла - Структура - Ключ и Значение метаданных должны быть написаны на латинице,
//                                  должны соответствовать правилам, установленным для идентификаторов.
//
Функция НовыйПараметрыЗагрузкиФайла() Экспорт
	
	ДанныеФайла = НовыйДанныеПрисоединенногоФайла();
	ДанныеФайла.Вставить("ДвоичныеДанныеФайла");
	
	ПараметрыЗагрузкиФайла = Новый Структура;
	ПараметрыЗагрузкиФайла.Вставить("ДанныеФайла", ДанныеФайла);
	ПараметрыЗагрузкиФайла.Вставить("МетаданныеФайла", Новый Структура);
	
	Возврат ПараметрыЗагрузкиФайла;
	
КонецФункции

// Загружает файл в объектное хранилище.
//  Данный метод вызывает исключения: при проверки параметров и список исключений см. ох_КоннекторS3.ЗагрузитьФайл.
//
// Параметры:
//   ПараметрыРаботыОбъектногоХранилища - Структура - ох_ОбъектноеХранилище.НовыйПараметрыРаботыСОбъектнымХранилищем.
//   ПараметрыЗагрузкиФайла - Структура - см. НовыйПараметрыЗагрузкиФайла.
//
// Возвращаемое значение:
//   Структура - см. ПараметрыВыполненияОперации.
//
Функция ЗагрузитьФайл(ПараметрыРаботыОбъектногоХранилища, ПараметрыЗагрузкиФайла) Экспорт
	
	ПараметрыВыполненияОперации = ПараметрыВыполненияОперации(ПараметрыРаботыОбъектногоХранилища, ПараметрыЗагрузкиФайла);
	
	Если Не ТребуетсяВыгрузкаФайла(ПараметрыВыполненияОперации) Тогда
		Возврат ПараметрыВыполненияОперации;
	КонецЕсли;
	
	ДобавитьНаименованиеФайлаВМетаданные(ПараметрыВыполненияОперации);
	
	РезультатЗагрузки = ЗагрузитьФайлХранилища(ПараметрыВыполненияОперации);
	ЗаполнитьРезультатОперации(ПараметрыВыполненияОперации, РезультатЗагрузки);
	
	Если Не ПараметрыВыполненияОперации.РезультатОперации.Ошибка Тогда
		
		ДанныеСсылки = ПолучитьСсылкуНаФайлХранилища(ПараметрыВыполненияОперации);
		ЗаписатьДанныеФайла(ПараметрыВыполненияОперации, ДанныеСсылки);
		ПараметрыВыполненияОперации.ДанныеФайлаХранилища.Вставить("ДанныеСсылки", ДанныеСсылки);
		
	КонецЕсли;
	
	Возврат ПараметрыВыполненияОперации;
	
КонецФункции

#КонецОбласти

#Область УдалениеФайла

// Возвращает набор параметров для удаления файла.
//
// Возвращаемое значение:
//  Структура:
//   * ДанныеФайла - Структура:
//    ** Ссылка - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//    ** Расширение - Строка - расширение присоединенного файла с точкой.
//    ** ВладелецФайла - ОпределяемыеТипы.ВладелецПрисоединенныхФайлов - владелец файла.
//    ** Наименование - Строка - имя файла.
//    ** ДатаМодификацииУниверсальная - Дата - дата изменения файла в системе.
//    ** ПометкаУдаления - Булево - пометка удадения файла.
//
Функция НовыйПараметрыУдаленияФайла() Экспорт
	
	ПараметрыУдаленияФайла = Новый Структура;
	ПараметрыУдаленияФайла.Вставить("ДанныеФайла", НовыйДанныеПрисоединенногоФайла());
	
	Возврат ПараметрыУдаленияФайла;
	
КонецФункции

// Удаляет файл из объектного хранилища.
//  Данный метод вызывает исключения: при проверки параметров и список исключений см. ох_КоннекторS3.УдалитьФайл.
//
// Параметры:
//   ПараметрыРаботыОбъектногоХранилища - Структура - НовыйПараметрыРаботыСОбъектнымХранилищем.
//   ПараметрыУдаленияФайла - Структура - см. НовыйПараметрыУдаленияФайла.
//
// Возвращаемое значение:
//   Структура - см. ПараметрыВыполненияОперации.
//
Функция УдалитьФайл(ПараметрыРаботыОбъектногоХранилища, ПараметрыУдаленияФайла) Экспорт
	
	ПараметрыВыполненияОперации = ПараметрыВыполненияОперации(ПараметрыРаботыОбъектногоХранилища, ПараметрыУдаленияФайла);
	
	РезультатУдаления = УдалитьФайлХранилища(ПараметрыВыполненияОперации);
	ЗаполнитьРезультатОперации(ПараметрыВыполненияОперации, РезультатУдаления);
	
	Если Не ПараметрыВыполненияОперации.РезультатОперации.Ошибка Тогда
		УдалитьДанныеФайла(ПараметрыВыполненияОперации);
	КонецЕсли;
	
	Возврат ПараметрыВыполненияОперации;
	
КонецФункции

#КонецОбласти

#Область ПолучениеСсылки

// Возвращает набор параметров для получения ссылки.
//
// Возвращаемое значение:
//  Структура:
//   * ДанныеФайла - Структура:
//    ** Ссылка - ОпределяемыеТипы.ПрисоединенныйФайл - присоединенный файл.
//    ** Расширение - Строка - расширение присоединенного файла с точкой.
//    ** ВладелецФайла - ОпределяемыеТипы.ВладелецПрисоединенныхФайлов - владелец файла.
//    ** Наименование - Строка - имя файла.
//    ** ДатаМодификацииУниверсальная - Дата - дата изменения файла в системе.
//    ** ПометкаУдаления - Булево - пометка удадения файла.
//
Функция НовыйПараметрыПолученияСсылки() Экспорт
	
	ПараметрыПолученияСсылки = Новый Структура;
	ПараметрыПолученияСсылки.Вставить("ДанныеФайла", НовыйДанныеПрисоединенногоФайла());
	
	Возврат ПараметрыПолученияСсылки;
	
КонецФункции

// Возвращает новую подписанную ссылку на файл в хранилище.
//  Данный метод вызывает исключения при проверки параметров.
//
// Параметры:
//   ПараметрыРаботыОбъектногоХранилища - Структура - НовыйПараметрыРаботыСОбъектнымХранилищем.
//   ПараметрыПолученияСсылки - Структура - см. НовыйПараметрыПолученияСсылки.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - Строка - подписанная ссылка на файл в хранилище.
//   * ВремяЖизниСсылки - Число - время действия ссылки в секундах.
//   * ДатаНачалаДействия - Дата - дата начала действия ссылки.
//   * ДатаОкончанияДействия - Дата - дата окончания действия ссылки.
//
Функция ПолучитьСсылкуФайла(ПараметрыРаботыОбъектногоХранилища, ПараметрыПолученияСсылки) Экспорт
	
	ПараметрыВыполненияОперации = ПараметрыВыполненияОперации(
		ПараметрыРаботыОбъектногоХранилища, ПараметрыПолученияСсылки);
		
	Возврат ПолучитьСсылкуНаФайлХранилища(ПараметрыВыполненияОперации);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет загрузку присоединенного файла в хранилище.
//
// Параметры:
//  ПараметрыВыполненияОперации - Структура - см. ПараметрыВыполненияОперации
//
// Возвращаемое значение:
//  Структура - см. ох_КоннекторS3.ЗагрузитьФайл
//
Функция ЗагрузитьФайлХранилища(ПараметрыВыполненияОперации) Экспорт
	
	ЗагрузкаФайла = ох_КоннекторS3.НовыйПараметрыЗагрузкиФайла();
	
	ЗагрузкаФайла.Бакет           = ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища.Бакет;
	ЗагрузкаФайла.КлючОбъекта     = ПараметрыВыполненияОперации.ДанныеФайлаХранилища.КлючОбъекта;
	ЗагрузкаФайла.ДанныеФайла     = ПараметрыВыполненияОперации.ДанныеФайла.ДвоичныеДанныеФайла;
	ЗагрузкаФайла.МетаданныеФайла = ПараметрыВыполненияОперации.ДополнительныеПараметры.МетаданныеФайла;
	
	Возврат ох_КоннекторS3.ЗагрузитьФайл(ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища, ЗагрузкаФайла);
	
КонецФункции

// Возвращает данные новой ссылки на файл в хранилище.
//
// Параметры:
//  ПараметрыВыполненияОперации - Структура - см. ПараметрыВыполненияОперации
//
// Возвращаемое значение:
//  Структура - см. ох_КоннекторS3.ПолучитьСсылку
//
Функция ПолучитьСсылкуНаФайлХранилища(ПараметрыВыполненияОперации) Экспорт
	
	НаименованиеФайла = ПараметрыВыполненияОперации.ДанныеФайла.Наименование;
	РасширениеФайла   = ПараметрыВыполненияОперации.ДанныеФайла.Расширение;
	
	ПолучениеСсылки = ох_КоннекторS3.НовыйПараметрыПолученияСсылки();
	
	ПолучениеСсылки.Бакет            = ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища.Бакет;
	ПолучениеСсылки.КлючОбъекта      = ПараметрыВыполненияОперации.ДанныеФайлаХранилища.КлючОбъекта;
	ПолучениеСсылки.ВремяЖизниСсылки = ВремяЖизниСсылки();
	ПолучениеСсылки.ИмяФайла         = ИмяФайла(НаименованиеФайла, РасширениеФайла);
	ПолучениеСсылки.Расширение       = РасширениеФайла;
	
	Возврат ох_КоннекторS3.ПолучитьСсылку(
		ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища, ПолучениеСсылки);
	
КонецФункции

// Удаляет файл из хранилища.
//
// Параметры:
//  ПараметрыВыполненияОперации - Структура - см. ПараметрыВыполненияОперации
//
// Возвращаемое значение:
//  Структура - см. ох_КоннекторS3.УдалитьФайл
//
Функция УдалитьФайлХранилища(ПараметрыВыполненияОперации) Экспорт

	УдалениеФайла = ох_КоннекторS3.НовыйПараметрыУдаленияФайла();
	УдалениеФайла.Бакет           = ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища.Бакет;
	УдалениеФайла.КлючОбъекта     = ПараметрыВыполненияОперации.ДанныеФайлаХранилища.КлючОбъекта;
	
	Возврат ох_КоннекторS3.УдалитьФайл(ПараметрыВыполненияОперации.ПараметрыРаботыОбъектногоХранилища, УдалениеФайла);

КонецФункции

