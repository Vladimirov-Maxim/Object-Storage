#Область Администрирование

Функция ОписаниеРегламентногоЗадания(РегламентноеЗадание)
	
	Задание = НовоеОписаниеРегламентногоЗадания();
	
	Задание.Имя                     = РегламентноеЗадание.Метаданные.Имя;
	Задание.Использование           = РегламентноеЗадание.Использование;
	Задание.Наименование            = РегламентноеЗадание.Наименование;
	Задание.Ключ                    = РегламентноеЗадание.Ключ;
	Задание.УникальныйИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
	Задание.ИмяПользователя         = РегламентноеЗадание.ИмяПользователя;
	Задание.Параметры               = РегламентноеЗадание.Параметры;
	Задание.Расписание              = РегламентноеЗадание.Расписание;
	Задание.ИмяМетода               = РегламентноеЗадание.Метаданные.ИмяМетода;
	
	Задание.ИнтервалПовтораПриАварийномЗавершении    = РегламентноеЗадание.ИнтервалПовтораПриАварийномЗавершении;
	Задание.КоличествоПовторовПриАварийномЗавершении = РегламентноеЗадание.КоличествоПовторовПриАварийномЗавершении;
	
	ПоследнееФоновоеЗадание = ПоследнееФоновоеЗаданиеРегламентногоЗадания(РегламентноеЗадание);
	
	Если ПоследнееФоновоеЗадание = Неопределено Тогда
		Возврат Задание;
	КонецЕсли;
	
	ДанныеЗадания = ОписаниеФоновогоЗадания(ПоследнееФоновоеЗадание);
	
	Задание.СообщениеОшибки = ДанныеЗадания.СообщениеОшибки;
	Задание.Начало          = ДанныеЗадания.Начало;
	Задание.Конец           = ДанныеЗадания.Конец;
	Задание.Состояние       = ДанныеЗадания.Состояние;
	Задание.ИмяПользователя = ДанныеЗадания.ИмяПользователя;
	
	Возврат Задание;
	
КонецФункции

Функция НовоеОписаниеРегламентногоЗадания()
	
	ОписаниеРегламентногоЗадания = Новый Структура;
	
	ОписаниеРегламентногоЗадания.Вставить("Использование", Ложь);
	
	ОписаниеРегламентногоЗадания.Вставить("Имя"         , "");
	ОписаниеРегламентногоЗадания.Вставить("Наименование", "");
	ОписаниеРегламентногоЗадания.Вставить("Ключ"        , "");
	ОписаниеРегламентногоЗадания.Вставить("УникальныйИдентификатор");
	
	ОписаниеРегламентногоЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"   , 0);
	ОписаниеРегламентногоЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении", 0);
	
	ОписаниеРегламентногоЗадания.Вставить("ИмяПользователя", "");
	ОписаниеРегламентногоЗадания.Вставить("Параметры"      , Новый Массив);
	ОписаниеРегламентногоЗадания.Вставить("Расписание"     , Новый РасписаниеРегламентногоЗадания);
	ОписаниеРегламентногоЗадания.Вставить("ИмяМетода"      , "");
	ОписаниеРегламентногоЗадания.Вставить("СообщениеОшибки", "");
	ОписаниеРегламентногоЗадания.Вставить("Начало"         , Дата(1, 1, 1));
	ОписаниеРегламентногоЗадания.Вставить("Конец"          , Дата(1, 1, 1));
	ОписаниеРегламентногоЗадания.Вставить("Состояние"      , "");
	
	Возврат ОписаниеРегламентногоЗадания;
	
КонецФункции

Функция ПоследнееФоновоеЗаданиеРегламентногоЗадания(РегламентноеЗадание)
	
	ПоследнееЗадание = Неопределено;
	
	ФоновыеЗаданияРегламентногоЗадания = Новый Массив;
	
	Если РегламентноеЗадание.ПоследнееЗадание <> Неопределено Тогда
		ФоновыеЗаданияРегламентногоЗадания.Добавить(РегламентноеЗадание.ПоследнееЗадание);
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", РегламентноеЗадание.УникальныйИдентификатор);
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	ох_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ФоновыеЗаданияРегламентногоЗадания, Задания);
	
	Отбор = Новый Структура;
	Отбор.Вставить("РегламентноеЗадание", РегламентноеЗадание);
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	ох_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ФоновыеЗаданияРегламентногоЗадания, Задания);
	
	Если Не ФоновыеЗаданияРегламентногоЗадания.Количество() Тогда
		Возврат ПоследнееЗадание;
	КонецЕсли;
	
	ПоследнееЗадание = ФоновыеЗаданияРегламентногоЗадания[0];
	
	Для Каждого Задание Из ФоновыеЗаданияРегламентногоЗадания Цикл
		
		Если ЗначениеЗаполнено(ПоследнееЗадание.Конец) Тогда
			
			Если Не ЗначениеЗаполнено(Задание.Конец)
				Или ПоследнееЗадание.Конец < Задание.Конец Тогда
				ПоследнееЗадание = Задание;
			КонецЕсли;
			
		Иначе
			
			Если Не ЗначениеЗаполнено(Задание.Конец)
				И ПоследнееЗадание.Начало < Задание.Начало Тогда
				ПоследнееЗадание = Задание;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПоследнееЗадание;
	
КонецФункции

Функция ОписаниеФоновогоЗадания(ФоновоеЗадание) Экспорт
	
	ДанныеЗадания = НовоеОписаниеФоновогоЗадания();
	
	ЗаполнитьЗначенияСвойств(ДанныеЗадания, ФоновоеЗадание);
	
	Если ФоновоеЗадание.ИнформацияОбОшибке <> Неопределено Тогда
		ДанныеЗадания.СообщениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ФоновоеЗадание.ИнформацияОбОшибке);
	КонецЕсли;
	
	ДанныеЗадания.Идентификатор         = ИдентификаторЗаданияИзКлюча(ФоновоеЗадание.Ключ);
	ДанныеЗадания.ИдентификаторРодителя = ИдентификаторРодителя(ФоновоеЗадание.Ключ);
	
	ПредставлениеСостояния = ПредставлениеСостояний()[ФоновоеЗадание.Состояние];
	Если ПредставлениеСостояния <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ДанныеЗадания, ПредставлениеСостояния);
	КонецЕсли;
	
	ДанныеЗадания.ИмяПользователя = ИмяПользователяЗаданий();

	Возврат ДанныеЗадания;
	
КонецФункции

Функция НовоеОписаниеФоновогоЗадания()
	
	ДанныеЗадания = Новый Структура;
	ДанныеЗадания.Вставить("ИмяМетода"            , "");
	ДанныеЗадания.Вставить("СообщениеОшибки"      , "");
	ДанныеЗадания.Вставить("Ключ"                 , "");
	ДанныеЗадания.Вставить("Начало"               , Дата(1, 1, 1));
	ДанныеЗадания.Вставить("Конец"                , Дата(1, 1, 1));
	ДанныеЗадания.Вставить("Наименование"         , "");
	ДанныеЗадания.Вставить("Состояние"            , "");
	ДанныеЗадания.Вставить("Идентификатор"        , "");
	ДанныеЗадания.Вставить("ИдентификаторРодителя", "");
	ДанныеЗадания.Вставить("ПодчиненныеПотоки"    , Новый Массив);
	ДанныеЗадания.Вставить("КартинкаСтроки"       , 0);
	ДанныеЗадания.Вставить("ИмяПользователя"      , "");
	ДанныеЗадания.Вставить("УникальныйИдентификатор");
	
	Возврат ДанныеЗадания;
	
КонецФункции

Функция ПредставлениеСостояний()
	
	Представление = Новый Соответствие;
	
	Представление.Вставить(СостояниеФоновогоЗадания.Активно,
		Новый Структура("Состояние, КартинкаСтроки", "Активно", 2));
	Представление.Вставить(СостояниеФоновогоЗадания.Завершено,
		Новый Структура("Состояние, КартинкаСтроки", "Завершено", 1));
	Представление.Вставить(СостояниеФоновогоЗадания.ЗавершеноАварийно,
		Новый Структура("Состояние, КартинкаСтроки", "Завершено аварийно", 3));
	Представление.Вставить(СостояниеФоновогоЗадания.Отменено,
		Новый Структура("Состояние, КартинкаСтроки", "Отменено", 3));
	
	Возврат Представление;
	
КонецФункции

Процедура ЗаполнитьПотокиЗадания(ДанныеЗадания, Потоки)
	
	Для Каждого Поток Из Потоки Цикл
		
		Если СтрНайти(Поток.Ключ, ДанныеЗадания.Ключ) Тогда
			
			ДанныеПотока = ОписаниеФоновогоЗадания(Поток);
			ДанныеЗадания.ПодчиненныеПотоки.Добавить(ДанныеПотока);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяПользователяЗаданий()
	
	Для Каждого РегламентноеЗадание Из ВсеРегламентныеЗаданияХранилища() Цикл
		Если ЗначениеЗаполнено(РегламентноеЗадание.ИмяПользователя) Тогда
			Возврат РегламентноеЗадание.ИмяПользователя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ВсеРегламентныеЗаданияХранилища()
	
	Задания = Новый Массив;
	
	Задание = РегламентныеЗадания.НайтиПредопределенное(
		Метаданные.РегламентныеЗадания.ох_ОбработкаЗаданийОбъектногоХранилища);
	Задания.Добавить(Задание);
	
	Задание = РегламентныеЗадания.НайтиПредопределенное(
		Метаданные.РегламентныеЗадания.ох_РегламентныеОперацииОбъектногоХранилища);
	Задания.Добавить(Задание);
	
	Возврат Задания;
	
КонецФункции

Функция ПредставлениеРегламентногоЗадания(Задание) Экспорт
	
	Результат = "Не определено";
	
	Если Задание <> Неопределено Тогда
		
		Результат = Задание.Наименование;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = Задание.Метаданные.Представление();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

