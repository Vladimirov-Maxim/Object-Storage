	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ох_ОчередьЗаданийОбъектногоХранилища КАК ох_ОчередьЗаданийОбъектногоХранилища
		|ГДЕ
		|	ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторПотока = &ИдентификаторПотока";
	
	Запрос.УстановитьПараметр("ИдентификаторПотока", ИдентификаторПотока);
	ИдентификаторыЗаданийПотока = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
	
	Возврат ох_ОбъектноеХранилище.МенеджерЗаданий().ЗаданияПоИдентификаторам(ИдентификаторыЗаданийПотока);

