#Область ОбработкаЗаданий

Процедура ВыполнитьРегламентныеОперацииОбъектногоХранилища() Экспорт
	
	Если Не ох_ОбъектноеХранилище.ИспользоватьИнтеграцию() Тогда
		Возврат;
	КонецЕсли;
	
	ох_ОбъектноеХранилище.ВыполнитьРегламентныеОперацииОбъектногоХранилища();
	
КонецПроцедуры

Процедура ОбработатьЗадания() Экспорт
	
	ох_ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ох_ОбработкаЗаданийОбъектногоХранилища);
	
	Если Не ох_ОбъектноеХранилище.ИспользоватьИнтеграцию() Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальноеКоличествоПотоковОбработкиЗаданий =
		ох_ОбъектноеХранилище.МаксимальноеКоличествоПотоковОбработкиЗаданий();
	
	Если МаксимальноеКоличествоПотоковОбработкиЗаданий <= 0 Тогда
		ох_ОбъектноеХранилище.ВыполнитьЗадания();
	Иначе
		ЗапуститьПотоковуюОбработкуЗаданий(МаксимальноеКоличествоПотоковОбработкиЗаданий);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПанельАдминистрирования

Функция РегламентныеЗаданияХранилища() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задания = Новый Массив;
	
	Для Каждого РегламентноеЗадание Из ВсеРегламентныеЗаданияХранилища() Цикл
		
		ОписаниеРегламентногоЗадания = ОписаниеРегламентногоЗадания(РегламентноеЗадание);
		Задания.Добавить(ОписаниеРегламентногоЗадания);
		
	КонецЦикла;
	
	Возврат Задания;
	
КонецФункции

Функция ФоновыеЗаданияХранилища(ТолькоАктивные = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задания = Новый Массив;
	
	УправляющиеЗадания = УправляющиеЗадания(ТолькоАктивные);
	ПотокиЗаданий = ПотокиВыполненияЗаданий(ТолькоАктивные);
	
	Для Каждого УправляющиеЗадание Из УправляющиеЗадания Цикл
		
		ДанныеЗадания = ОписаниеФоновогоЗадания(УправляющиеЗадание);
		ЗаполнитьПотокиЗадания(ДанныеЗадания, ПотокиЗаданий);
		
		Задания.Добавить(ДанныеЗадания);
		
	КонецЦикла;
	
	Возврат Задания;
	
КонецФункции

Функция ОписаниеРегламентногоЗаданияПоИдентификатору(ИдентификаторЗадания) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	Если Задание <> Неопределено Тогда
		Возврат ОписаниеРегламентногоЗадания(Задание);
	Иначе
		Возврат НовоеОписаниеРегламентногоЗадания();
	КонецЕсли;
	
КонецФункции

Функция ОписаниеФоновогоЗаданияПоИдентификатору(ИдентификаторЗадания) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	Если Задание <> Неопределено Тогда
		Возврат ОписаниеФоновогоЗадания(Задание);
	Иначе
		Возврат НовоеОписаниеФоновогоЗадания();
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьРегламентноеЗадание(ИдентификаторЗадания) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	ФоновоеЗадание = ПоследнееФоновоеЗаданиеРегламентногоЗадания(РегламентноеЗадание);
	
	ЗапускВыполнен = Ложь;
	УжеВыполняется = Ложь;
	
	Если ФоновоеЗадание <> Неопределено
		И ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		
		УжеВыполняется = Истина;
		
	Иначе
		
		НаименованиеФоновогоЗадания = СтрШаблон("Запуск вручную: %1", 
			ПредставлениеРегламентногоЗадания(РегламентноеЗадание));
		КлючФоновогоЗадания = Строка(РегламентноеЗадание.УникальныйИдентификатор);
		
		ФоновоеЗадание = ФоновыеЗадания.Выполнить(
			РегламентноеЗадание.Метаданные.ИмяМетода,
			РегламентноеЗадание.Параметры,
			КлючФоновогоЗадания,
			НаименованиеФоновогоЗадания);
			
		ЗапускВыполнен = Истина;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЗапускВыполнен", ЗапускВыполнен);
	Результат.Вставить("УжеВыполняется", УжеВыполняется);
	Результат.Вставить("Начало"        , ФоновоеЗадание.Начало);
	Результат.Вставить("Конец"         , ФоновоеЗадание.Конец);
	Результат.Вставить("Состояние"     , ФоновоеЗадание.Состояние);
	
	ПредставлениеФоновогоЗадания = ФоновоеЗадание.Наименование;
	Если Не ЗначениеЗаполнено(ПредставлениеФоновогоЗадания) Тогда
		ПредставлениеФоновогоЗадания = ПредставлениеРегламентногоЗадания(РегламентноеЗадание);
	КонецЕсли;
	Результат.Вставить("ПредставлениеФоновогоЗадания", ПредставлениеФоновогоЗадания);
	
	СообщениеОшибки = "";
	Если ФоновоеЗадание.ИнформацияОбОшибке <> Неопределено Тогда
		СообщениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ФоновоеЗадание.ИнформацияОбОшибке);
	КонецЕсли;
	Результат.Вставить("СообщениеОшибки", СообщениеОшибки);
	
	Возврат Результат;
	
КонецФункции

