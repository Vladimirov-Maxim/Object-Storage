#Область МногопоточнаяОбработкаЗаданий

Процедура ЗапуститьПотоковуюОбработкуЗаданий(КоличествоПотоков)
	
	Если УправляющееЗаданиеЗапущено() Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьУправляющееЗадание();
	
КонецПроцедуры

#Область УправляющийПоток

Функция УправляющееЗаданиеЗапущено()
	
	Задания = УправляющиеЗадания(Истина);
	Возврат Задания.Количество() > 0;
	
КонецФункции

Функция УправляющиеЗадания(ТолькоАктивные = Ложь)
	
	ОтборУправляющегоЗадания = Новый Структура;
	ОтборУправляющегоЗадания.Вставить("ИмяМетода", МетодВыполненияУправляющегоЗадания());
	
	Возврат ФоновыеЗаданияПроцесса(ОтборУправляющегоЗадания, ТолькоАктивные);

КонецФункции

Процедура ЗапуститьУправляющееЗадание()
	
	ИдентификаторЗадания = XMLСтрока(Новый УникальныйИдентификатор());
	
	ФоновыеЗадания.Выполнить(
		МетодВыполненияУправляющегоЗадания(),
		ох_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторЗадания),
		КлючУправляющегоЗадания(ИдентификаторЗадания),
		НаименованиеЗаданияПотоковойОбработки("Управляющее"));
	
КонецПроцедуры

Функция МетодВыполненияУправляющегоЗадания() Экспорт
	Возврат "ох_ОбъектноеХранилищеСлужебный.ВыполнитьОбработкуЗаданийПотоками";
КонецФункции

Процедура ВыполнитьОбработкуЗаданийПотоками(ИдентификаторУправляющегоЗадания) Экспорт
	
	МаксимальноеКоличествоПотоков    = ох_ОбъектноеХранилище.МаксимальноеКоличествоПотоковОбработкиЗаданий();
	ОжиданиеЗавершенияЗаданияСекунды = 5;
	ОжиданиеОчередиМиллисекунды      = 3000;
	
	Пока Истина Цикл
		
		АктивныеПотоки = ПотокиВыполненияЗаданий(Истина);
		КоличествоАктивныхПотоков = АктивныеПотоки.Количество();
		
		ОчиститьРегистрациюОчереди(АктивныеПотоки, ИдентификаторУправляющегоЗадания);
		
		ИспользоватьИнтеграцию = ИспользоватьИнтеграцию();
		
		Если ИспользоватьИнтеграцию
			И КоличествоАктивныхПотоков < МаксимальноеКоличествоПотоков Тогда
			
			ОчередьЗаданийОбработки = ОчередьЗаданий();
			
			Если Не ОчередьЗаданийОбработки.Количество() Тогда
				ВызватьПаузу(ОжиданиеОчередиМиллисекунды);
				Продолжить;
			КонецЕсли;
			
			ИдентификаторПотока = Строка(Новый УникальныйИдентификатор);
			
			ЗарегистрироватьОчередь(ОчередьЗаданийОбработки, ИдентификаторПотока);
			ЗапуститьПоток(ИдентификаторУправляющегоЗадания, ИдентификаторПотока);
			
		ИначеЕсли КоличествоАктивныхПотоков Тогда
			
			ФоновыеЗадания.ОжидатьЗавершенияВыполнения(АктивныеПотоки, ОжиданиеЗавершенияЗаданияСекунды);
			Продолжить;
			
		Иначе
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗарегистрироватьОчередь(ЗаданияОчереди, ИдентификаторПотока)
	
	МенеджерЗаданий = ох_ОбъектноеХранилище.МенеджерЗаданий();
	МенеджерОчереди = РегистрыСведений.ох_ОчередьЗаданийОбъектногоХранилища;
	
	Пока ЗаданияОчереди.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			МенеджерЗаданий.ПеренестиЗаданиеВОчередь(ЗаданияОчереди);
			
			ЗаписьОчереди = МенеджерОчереди.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ЗаписьОчереди, ЗаданияОчереди);
			ЗаписьОчереди.ИдентификаторПотока = ИдентификаторПотока;
			ЗаписьОчереди.Записать();
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ЗаписьЖурналаРегистрации(
				СобытиеОбработкиОчереди(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьРегистрациюОчереди(АктивныеПотоки, ИдентификаторУправляющегоЗадания)
	
	Менеджеры = Новый Структура;
	Менеджеры.Вставить("Задания", ох_ОбъектноеХранилище.МенеджерЗаданий());
	Менеджеры.Вставить("Очередь", РегистрыСведений.ох_ОчередьЗаданийОбъектногоХранилища);
	
	ИдентификаторыАктивныхПотоков = Новый Массив;
	Для Каждого Поток Из АктивныеПотоки Цикл
		ИдентификаторыАктивныхПотоков.Добавить(ИдентификаторЗаданияИзКлюча(Поток.Ключ));
	КонецЦикла;
	
	ОчередиПотоков = ОчередиНеактивныхПотоков(ИдентификаторыАктивныхПотоков);
	
	Пока ОчередиПотоков.Следующий() Цикл
		
		Если ОчередиПотоков.ЗаданиеВыполнено Тогда
			ОчиститьОчередьПотокаПакетно(ОчередиПотоков.ИдентификаторПотока, Менеджеры);
		Иначе
			
			ДанныеПотока = ДанныеПотокаПоИдентификатору(ИдентификаторУправляющегоЗадания, ОчередиПотоков.ИдентификаторПотока);
			ВыборкаЗаданий = ОчередиПотоков.Выбрать();
			ОбработкаОчередиПоЗаданиям(ВыборкаЗаданий, ДанныеПотока, Менеджеры);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОчередиНеактивныхПотоков(ИдентификаторыАктивныхПотоков)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МенеджерЗаданий = ох_ОбъектноеХранилище.МенеджерЗаданий();
	МенеджерЗаданий.ПоместитьЗаданияВОчередиВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторФайла КАК ИдентификаторФайла,
		|	ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторПотока КАК ИдентификаторПотока,
		|	Задания.Период КАК Период,
		|	Задания.Файл КАК Файл,
		|	Задания.ВладелецФайла КАК ВладелецФайла,
		|	Задания.СервисныйАккаунт КАК СервисныйАккаунт,
		|	Задания.Бакет КАК Бакет,
		|	Задания.Файл ЕСТЬ NULL КАК ЗаданиеВыполнено
		|ИЗ
		|	РегистрСведений.ох_ОчередьЗаданийОбъектногоХранилища КАК ох_ОчередьЗаданийОбъектногоХранилища
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задания КАК Задания
		|		ПО ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторЗаписи = Задания.ИдентификаторЗаписи
		|			И ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторФайла = Задания.ИдентификаторФайла
		|ГДЕ
		|	НЕ ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторПотока В (&ИдентификаторыАктивныхПотоков)
		|ИТОГИ
		|	МИНИМУМ(ЗаданиеВыполнено)
		|ПО
		|	ИдентификаторПотока";
	
	Запрос.УстановитьПараметр("ИдентификаторыАктивныхПотоков", ИдентификаторыАктивныхПотоков);
	
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Процедура ОчиститьОчередьПотокаПакетно(ИдентификаторПотока, Менеджеры)
	
	НаборЗаписей = Менеджеры.Очередь.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторПотока.Установить(ИдентификаторПотока);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ОбработкаОчередиПоЗаданиям(Задания, ДанныеПотока, Менеджеры)
	
	Пока Задания.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Запись = Менеджеры.Очередь.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Задания);
			Запись.Удалить();
			
			Если Не Задания.ЗаданиеВыполнено Тогда
				
				Если ДанныеПотока.ЕстьДанныеПотока
					И (ДанныеПотока.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно
					Или ДанныеПотока.Состояние = СостояниеФоновогоЗадания.Отменено) Тогда
					Менеджеры.Задания.УстановитьОшибкуВыполненияЗадания(Задания, ДанныеПотока.СообщениеОшибки);
				Иначе
					Менеджеры.Задания.ЗарегистрироватьЗаданиеКОбработке(Задания);
				КонецЕсли;
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ЗаписьЖурналаРегистрации(
				СобытиеОбработкиОчереди(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеПотокаПоИдентификатору(ИдентификаторУправляющегоЗадания, ИдентификаторПотока)
	
	ДанныеПотока = Новый Структура;
	ДанныеПотока.Вставить("ЕстьДанныеПотока", Ложь);
	ДанныеПотока.Вставить("Состояние");
	ДанныеПотока.Вставить("СообщениеОшибки", "Неизвестная ошибка");
	
	ОтборЗадания = Новый Структура;
	ОтборЗадания.Вставить("Ключ", КлючПотока(ИдентификаторУправляющегоЗадания, ИдентификаторПотока));
	
	ЗаданияПотока = ФоновыеЗаданияПроцесса(ОтборЗадания);
	
	Если ЗаданияПотока.Количество() Тогда
		
		Поток = ЗаданияПотока[0];
		
		ДанныеПотока.ЕстьДанныеПотока = Истина;
		ДанныеПотока.Состояние        = Поток.Состояние;
		
		Если Поток.ИнформацияОбОшибке <> Неопределено Тогда
			ДанныеПотока.СообщениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Поток.ИнформацияОбОшибке);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеПотока;
	
КонецФункции

Функция ОчередьЗаданий()
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МенеджерЗаданий = ох_ОбъектноеХранилище.МенеджерЗаданий();
	МенеджерЗаданий.ПоместитьЗаданияДляОбработкиВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задания.Период КАК Период,
		|	Задания.Файл КАК Файл,
		|	Задания.ВладелецФайла КАК ВладелецФайла,
		|	Задания.СервисныйАккаунт КАК СервисныйАккаунт,
		|	Задания.Бакет КАК Бакет,
		|	Задания.Операция КАК Операция,
		|	Задания.Статус КАК Статус,
		|	Задания.ДатаНачалаВыполнения КАК ДатаНачалаВыполнения,
		|	Задания.ДатаОкончанияВыполнения КАК ДатаОкончанияВыполнения,
		|	Задания.КоличествоПопытокВыполнения КАК КоличествоПопытокВыполнения,
		|	Задания.ОписаниеОшибки КАК ОписаниеОшибки,
		|	Задания.Ответственный КАК Ответственный,
		|	Задания.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	Задания.ИдентификаторФайла КАК ИдентификаторФайла
		|ИЗ
		|	Задания КАК Задания
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ох_ОчередьЗаданийОбъектногоХранилища КАК ЗаданияВОбработке
		|		ПО Задания.ИдентификаторЗаписи = ЗаданияВОбработке.ИдентификаторЗаписи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ох_ОчередьЗаданийОбъектногоХранилища КАК ФайлыВОбработке
		|		ПО Задания.ИдентификаторФайла = ФайлыВОбработке.ИдентификаторФайла
		|ГДЕ
		|	ЗаданияВОбработке.ИдентификаторПотока ЕСТЬ NULL
		|	И ФайлыВОбработке.ИдентификаторПотока ЕСТЬ NULL";
	
	КоличествоЗаданийНаПоток = ох_ОбъектноеХранилище.КоличествоЗаданийВыполняемыхОднимПотоком();
	Запрос.Текст = СтрЗаменить(
		Запрос.Текст,
		"ПЕРВЫЕ 1",
		СтрШаблон("ПЕРВЫЕ %1", Формат(КоличествоЗаданийНаПоток, "ЧРГ=; ЧГ=0")));
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти

