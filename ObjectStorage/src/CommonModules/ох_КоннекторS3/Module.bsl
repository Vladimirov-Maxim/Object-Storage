Функция НовыйОтветФайлыБакета()
	
	ДанныеФайлов = Новый ТаблицаЗначений;
	ДанныеФайлов.Колонки.Добавить("Ключ"         , ох_ОбщегоНазначения.ОписаниеТипаСтрока(250));
	ДанныеФайлов.Колонки.Добавить("ДатаИзменения", ох_ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ДанныеФайлов.Колонки.Добавить("Размер"       , ох_ОбщегоНазначения.ОписаниеТипаЧисло(15));
	ДанныеФайлов.Колонки.Добавить("Расширение"   , ох_ОбщегоНазначения.ОписаниеТипаСтрока(10));
	
	Ответ = Новый Структура;
	Ответ.Вставить("ВсеФайлыПолучены", Истина);
	Ответ.Вставить("Файлы"           , ДанныеФайлов);
	Ответ.Вставить("СледующийТокен");
	
	Возврат Ответ;
	
КонецФункции

Функция СформироватьОтветОбработкиФайла(ПараметрыПолученияФайлов, ОтветКоннектор)
	Возврат СформироватьОтвет(ОтветКоннектор);
