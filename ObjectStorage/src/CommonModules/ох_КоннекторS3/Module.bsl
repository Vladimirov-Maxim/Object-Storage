// Конструктор ответа методов хранилища.
//
// Возвращаемое значение:
//  Структура:
//   * Метод - Строка - метод HTTP.
//   * Заголовки - Соответствие - заголовки HTTP ответов.
//   * Кодировка - Строка - кодировка результата.
//   * Результат - ДвоичныеДанные - тело ответа.
//   * КодСостояния - Число - код состояния HTTP ответа.
//   * URL - Строка - URL метода.
//   * Ошибка - Булево - флаг ошибки метода.
//   * КлассификацияОшибки - Строка - классификация ошибки по данным сервиса.
//   * Сообщение - Строка - описание ошибки.
//   * ИдентификаторЗапроса - Строка - идентификатор запроса на стороне сервиса.
//
Функция НовыйОтветКоннектора() Экспорт
	
	Ответ = Новый Структура;
	
	Ответ.Вставить("Метод"               , "");
	Ответ.Вставить("Заголовки"           , Новый Соответствие);
	Ответ.Вставить("Кодировка"           , "");
	Ответ.Вставить("Результат"           , Истина);
	Ответ.Вставить("КодСостояния"        , 200);
	Ответ.Вставить("URL"                 , "");
	Ответ.Вставить("Ошибка"              , Ложь);
	Ответ.Вставить("КлассификацияОшибки" , "");
	Ответ.Вставить("Сообщение"           , "");
	Ответ.Вставить("ИдентификаторЗапроса", "");
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает общий модуль КоннекторHTTP (локальная приватная обёртка, единственный потребитель - ох_КоннекторS3).
// Проверка наличия - через Метаданные.ОбщиеМодули.Найти (КоннекторHTTP не подсистема БСП, а отдельный модуль).
//
// Возвращаемое значение:
//  ОбщийМодуль - общий модуль КоннекторHTTP.
//
Функция МодульКоннектораHTTP()

	Если ох_ОбщегоНазначения.МодульДоступен("КоннекторHTTP") Тогда
		Возврат ох_ОбщегоНазначения.ОбщийМодуль("КоннекторHTTP");
	КонецЕсли;

	ВызватьИсключение ох_ОбщегоНазначенияКлиентСервер.ТекстОшибкиНедоступнаЗависимость("КоннекторHTTP", "общий модуль");

КонецФункции

