
#Область ПрограммныйИнтерфейс

// Возвращает параметры работы коннектора.
//
// Возвращаемое значение:
//  НастройкиСервисногоАккаунта - Структура - см. ох_ОбъектноеХранилище.НастройкиСервисногоАккаунта.
//  Сессия - Структура - НоваяСессия.
//
Функция НовыйПараметрыКоннектора() Экспорт
	
	ПараметрыКоннектора = Новый Структура;
	ПараметрыКоннектора.Вставить("НастройкиСервисногоАккаунта");
	ПараметрыКоннектора.Вставить("Сессия", НоваяСессия());
	
	Возврат ПараметрыКоннектора;
	
КонецФункции

#Область ОбщееСостояниеХранилища

// Возвращает результат проверки подключения.
//
// Параметры:
//  СервисныйАккаунт - СправочникСсылка.ох_СервисныеАккаунтыОбъектныхХранилищ - сервисный аккаунт.
//  НастройкиСервисногоАккаунта - Структура -
//            см. Справочники.ох_СервисныеАккаунтыОбъектныхХранилищ.НовыйНастройкиСервисногоАккаунта.
//
// Возвращаемое значение:
//  Структура - см. НовыйОтветКоннектора.
//
Функция ПроверитьПодключение(СервисныйАккаунт, Знач НастройкиСервисногоАккаунта = Неопределено) Экспорт
	
	Если НастройкиСервисногоАккаунта = Неопределено Тогда
		НастройкиСервисногоАккаунта = ох_ОбъектноеХранилище.НастройкиСервисногоАккаунта(СервисныйАккаунт);
	КонецЕсли;
	
	ПараметрыКоннектора = НовыйПараметрыКоннектора();
	ПараметрыКоннектора.НастройкиСервисногоАккаунта = НастройкиСервисногоАккаунта;
	
	URIЗапроса = URL(ПараметрыКоннектора.НастройкиСервисногоАккаунта) + РазделительURI();
	
	ДополнительныеПараметры = ДополнительныеПараметрыМетодов(ПараметрыКоннектора.НастройкиСервисногоАккаунта);
	ДополнительныеПараметры.МаксимальноеКоличествоПовторов = 0;
	ДополнительныеПараметры.Таймаут = 10;
	
	ОтветКоннектор = ВызватьМетод("GET", URIЗапроса, ДополнительныеПараметры, ПараметрыКоннектора.Сессия);
	
	Возврат СформироватьОтвет(ОтветКоннектор);
	
КонецФункции

#КонецОбласти

#Область РаботаСФайлами

// Возвращает набор параметров для получения файла.
//
// Возвращаемое значение:
//  Структура:
//   * Бакет - Строка - имя бакета.
//   * КлючОбъекта - Строка - ключ объекта в объектном хранилище, должен быть уникален в разрезе бакета.
//   * ОбрабатыватьКлючОбъектаСКаталогами - Булево
//         Истина - ключом объекта будет полное имя файла Каталог\ИмяФайла.Расширение
//         Ложь - ключом объекта будет только имя файла с расширением.
//   * Расширение - Строка - расширение файла с точкой.
//
Функция НовыйПараметрыПолученияФайла() Экспорт
	
	ПараметрыПолученияФайла = НовыйОбщиеПараметрыОбработкиФайла();
	ПараметрыПолученияФайла.Вставить("Расширение", "");
	
	Возврат ПараметрыПолученияФайла;
	
КонецФункции

// Получает файл из объектного хранилища.
// Данный метод может выбросить исключение ОшибкаСети.
//
// Параметры:
//  ПараметрыРаботыКоннектора - Структура - см. НовыйПараметрыКоннектора.
//  ПараметрыПолученияФайла - Структура - см. НовыйПараметрыПолученияФайла.
//
// Возвращаемое значение:
//   Ответ - см. НовыйОтветКоннектора.
//
Функция ПолучитьФайл(ПараметрыРаботыКоннектора, ПараметрыПолученияФайла) Экспорт
	
	URIОбъекта = URIОбъекта(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта, ПараметрыПолученияФайла);
	
	MIMEТипРасширенияФайла = MIMEТипДляРасширенияФайла(ПараметрыПолученияФайла.Расширение);
	
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("response-content-type", MIMEТипРасширенияФайла);
	
	ДополнительныеПараметры = ДополнительныеПараметрыМетодов(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта);
	ДополнительныеПараметры.ПараметрыЗапроса = ПараметрыЗапроса;
	
	ОтветКоннектор = ВызватьМетод("GET", URIОбъекта, ДополнительныеПараметры, ПараметрыРаботыКоннектора.Сессия);
	Ответ = СформироватьОтветОбработкиФайла(ПараметрыПолученияФайла, ОтветКоннектор);
	
	Возврат Ответ;
	
КонецФункции

// Возвращает набор параметров для загрузки файла.
//
// Возвращаемое значение:
//  Структура:
//   * Бакет - Строка - имя бакета.
//   * КлючОбъекта - Строка - ключ объекта в объектном хранилище, должен быть уникален в разрезе бакета.
//   * ОбрабатыватьКлючОбъектаСКаталогами - Булево
//         Истина - ключом объекта будет полное имя файла Каталог\ИмяФайла.Расширение
//         Ложь - ключом объекта будет только имя файла с расширением.
//   * ДанныеФайла - ДвоичныеДанные - файл для помещения.
//   * МетаданныеФайла - Структура - Ключ и Значение метаданных должны быть написаны на латинице,
//                                  должны соответствовать правилам, установленным для идентификаторов.
//
Функция НовыйПараметрыЗагрузкиФайла() Экспорт
	
	ПараметрыЗагрузкиФайла = НовыйОбщиеПараметрыОбработкиФайла();
	ПараметрыЗагрузкиФайла.Вставить("ДанныеФайла");
	ПараметрыЗагрузкиФайла.Вставить("МетаданныеФайла", Новый Структура);
	
	Возврат ПараметрыЗагрузкиФайла;
	
КонецФункции

// Загружает файл в объектное хранилище.
// Данный метод может выбросить исключения ОшибкаСети.
//
// Параметры:
//  ПараметрыРаботыКоннектора - Структура - см. НовыйПараметрыКоннектора.
//  ПараметрыЗагрузкиФайла - Структура - см. НовыйПараметрыЗагрузкиФайла.
//
// Возвращаемое значение:
//   Ответ - см. НовыйОтветКоннектора.
//
Функция ЗагрузитьФайл(ПараметрыРаботыКоннектора, ПараметрыЗагрузкиФайла) Экспорт
	
	URIОбъекта = URIОбъекта(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта, ПараметрыЗагрузкиФайла);
	
	ОписаниеМетаданных = ЗаголовкиМетаданныхФайла(ПараметрыЗагрузкиФайла.МетаданныеФайла);
	
	Заголовки = Новый Соответствие;
	ох_ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(Заголовки, ОписаниеМетаданных);
	
	ДополнительныеПараметры = ДополнительныеПараметрыМетодов(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта);
	ДополнительныеПараметры.Данные    = ПараметрыЗагрузкиФайла.ДанныеФайла;
	ДополнительныеПараметры.Заголовки = Заголовки;
	
	ОтветКоннектор = ВызватьМетод("PUT", URIОбъекта, ДополнительныеПараметры, ПараметрыРаботыКоннектора.Сессия);
	Ответ = СформироватьОтветОбработкиФайла(ПараметрыЗагрузкиФайла, ОтветКоннектор);
	
	Возврат Ответ;

КонецФункции

// Возвращает набор параметров для удаления файла.
//
// Возвращаемое значение:
//  Структура:
//   * Бакет - Строка - имя бакета.
//   * КлючОбъекта - Строка - ключ объекта в объектном хранилище, должен быть уникален в разрезе бакета.
//   * ОбрабатыватьКлючОбъектаСКаталогами - Булево
//         Истина - ключом объекта будет полное имя файла Каталог\ИмяФайла.Расширение.
//         Ложь - ключом объекта будет только имя файла с расширением.
//
Функция НовыйПараметрыУдаленияФайла() Экспорт
	Возврат НовыйОбщиеПараметрыОбработкиФайла();
КонецФункции

// Удаляет файл из объектного хранилища.
// Данный метод может выбросить исключение ОшибкаСети.
//
// Параметры:
//  ПараметрыРаботыКоннектора - Структура - см. НовыйПараметрыКоннектора.
//  ПараметрыУдаленияФайла - Структура - см. НовыйПараметрыУдаленияФайла.
//
// Возвращаемое значение:
//   Ответ - см. НовыйОтветКоннектора.
//
Функция УдалитьФайл(ПараметрыРаботыКоннектора, ПараметрыУдаленияФайла) Экспорт
	
	URIОбъекта = URIОбъекта(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта, ПараметрыУдаленияФайла);
	
	ДополнительныеПараметры = ДополнительныеПараметрыМетодов(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта);
	
	ОтветКоннектор = ВызватьМетод("DELETE", URIОбъекта, ДополнительныеПараметры, ПараметрыРаботыКоннектора.Сессия);
	Ответ = СформироватьОтветОбработкиФайла(ПараметрыУдаленияФайла, ОтветКоннектор);
	
	Возврат Ответ;
	
КонецФункции

// Возвращает набор параметров для получения подписанной ссылки.
//
// Возвращаемое значение:
//  Структура:
//   * Бакет - Строка - имя бакета.
//   * КлючОбъекта - Строка - ключ объекта в объектном хранилище, должен быть уникален в разрезе бакета.
//   * ОбрабатыватьКлючОбъектаСКаталогами - Булево
//         Истина - ключом объекта будет полное имя файла Каталог\ИмяФайла.Расширение.
//         Ложь - ключом объекта будет только имя файла с расширением.
//   * ВремяЖизниСсылки - Число - время жизни ссылки в секундах, по умолчанию 7 дней.
//   * ДатаЗапроса - Дата
//                 - Дата со временем, если необходимо получить идентичную ссылку за небольшой промежуток времени.
//   * ЧасовойПоясЗапроса - Строка - часовой пояс параметра ДатаЗапроса для определения универсального времени.
//
Функция НовыйПараметрыПолученияСсылки() Экспорт
	
	ПараметрыПолученияСсылки = НовыйОбщиеПараметрыОбработкиФайла();
	ПараметрыПолученияСсылки.Вставить("ВремяЖизниСсылки");
	ПараметрыПолученияСсылки.Вставить("ИмяФайла");
	ПараметрыПолученияСсылки.Вставить("Расширение");
	
	ПараметрыПолученияСсылки.Вставить("ДатаЗапроса", ТекущаяДатаСеанса());
	ПараметрыПолученияСсылки.Вставить("ЧасовойПоясЗапроса", ЧасовойПоясСеанса());
	
	Возврат ПараметрыПолученияСсылки;
	
КонецФункции

// Формирует подписанную ссылку.
// Данный метод не выбрасывает исключение.
//
// Параметры:
//  ПараметрыРаботыКоннектора - Структура - см. НовыйПараметрыКоннектора.
//  ПараметрыПолученияСсылки - Структура - см. НовыйПараметрыПолученияСсылки.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - Строка - подписанная ссылка на файл.
//   * ВремяЖизниСсылки - Число - Время жизни ссылки в секундах.
//   * ДатаНачалаДействия - Дата - Дата начала действия ссылки.
//   * ДатаОкончанияДействия - Дата - Дата окончания действия ссылки.
//
Функция ПолучитьСсылку(ПараметрыРаботыКоннектора, ПараметрыПолученияСсылки) Экспорт
	
	Ссылка = ПолучитьПодписаннуюСсылку(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта, ПараметрыПолученияСсылки);
	
	СсылкаФайла = Новый Структура;
	СсылкаФайла.Вставить("Ссылка"               , Ссылка);
	СсылкаФайла.Вставить("ВремяЖизниСсылки"     , ПараметрыПолученияСсылки.ВремяЖизниСсылки);
	СсылкаФайла.Вставить("ДатаНачалаДействия"   , ПараметрыПолученияСсылки.ДатаЗапроса);
	СсылкаФайла.Вставить("ДатаОкончанияДействия",
		ПараметрыПолученияСсылки.ДатаЗапроса + ПараметрыПолученияСсылки.ВремяЖизниСсылки);
	
	Возврат СсылкаФайла;
	
КонецФункции

#КонецОбласти

#Область РаботаСБакетом

// Получает все бакеты хранилища.
//  Данный метод может выбросить исключение ОшибкаСети.
//
// Параметры:
//  ПараметрыРаботыКоннектора - Структура - см. НовыйПараметрыКоннектора.
//
// Возвращаемое значение:
//  Структура:
//   * см. НовыйОтветКоннектора.
//   * Бакеты - Массив - имена бакетов в хранилище.
//
Функция ВсеБакетыХранилища(ПараметрыРаботыКоннектора) Экспорт
	
	URIЗапроса              = URL(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта) + РазделительURI();
	ДополнительныеПараметры = ДополнительныеПараметрыМетодов(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта);
	ОтветКоннектор          = ВызватьМетод("GET", URIЗапроса, ДополнительныеПараметры, ПараметрыРаботыКоннектора.Сессия);
	
	Ответ = СформироватьОтвет(ОтветКоннектор);
	Ответ.Вставить("Бакеты", Новый Массив);
	
	Если Ответ.Ошибка Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Попытка
		Бакеты = РазобратьОтветСпискаБакетов(ОтветКоннектор);
		Ответ.Бакеты = Бакеты;
	Исключение
		
		Ответ.Ошибка              = Истина;
		Ответ.Сообщение           = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Ответ.КлассификацияОшибки = "ОшибкаЧтенияДанныхСервиса";
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Возвращает набор параметров получения файлов бакета.
//
// Возвращаемое значение:
//   Структура:
//    * Бакет - Строка - имя бакета.
//    * Префикс - Строка - будут выбраны файлы, которые начинаются с данного префикса.
//    * КоличествоФайлов - Число - Количество файлов, которое необходимо получить,
//                                если не указано, то получает все файлы, но не более 1000.
//    * ТокенЗапроса - Строка - токен следующего запроса, если в первый запрос файлов не поместились все файлы,
//                          то в ответе метода ПолучитьФайлыБакета будет токен,
//                          который необходимо передать в данный параметр.
//
Функция НовыйПараметрыПолученияФайловБакета() Экспорт
	
	ПараметрыПолученияФайловБакета = НовыйОбщиеПараметрыОбработкиБакета();
	ПараметрыПолученияФайловБакета.Вставить("Префикс");
	ПараметрыПолученияФайловБакета.Вставить("КоличествоФайлов", 0);
	ПараметрыПолученияФайловБакета.Вставить("ТокенЗапроса");
	
	Возврат ПараметрыПолученияФайловБакета;
	
КонецФункции

// Получает файлы бакет.
//  Данный метод может выбросить исключение ОшибкаСети.
//
// Параметры:
//  ПараметрыРаботыКоннектора - Структура - см. НовыйПараметрыКоннектора.
//  ПараметрыПолученияФайловБакета - Структура - см. НовыйПараметрыПолученияФайловБакета.
//
// Возвращаемое значение:
//  Структура:
//   * см. НовыйОтветКоннектора.
//   * Файлы - ТаблицаЗначений - см. ох_КоннекторS3.НовыйДанныеФайловБакета.
//   * ВсеФайлыПолучены - Булево - признак, что в запросе вернулись все файлы.
//   * Следующий токен - Строка - токен следующего запроса файлов, в случае если ВсеФайлыПолучены = Ложь.
//                       Максимальное количество файлов за один запрос - 1000
//
Функция ПолучитьФайлыБакета(ПараметрыРаботыКоннектора, ПараметрыПолученияФайловБакета) Экспорт
	
	URIБакета = URIБакета(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта, ПараметрыПолученияФайловБакета);
	
	ПараметрыЗапроса = СформироватьПараметрыЗапросаФайловБакета(ПараметрыПолученияФайловБакета);
	
	ДополнительныеПараметры = ДополнительныеПараметрыМетодов(ПараметрыРаботыКоннектора.НастройкиСервисногоАккаунта);
	ДополнительныеПараметры.ПараметрыЗапроса = ПараметрыЗапроса;
	
	ОтветКоннектор = ВызватьМетод("GET", URIБакета, ДополнительныеПараметры, ПараметрыРаботыКоннектора.Сессия);
	Ответ = СформироватьОтветОбработкиБакета(ОтветКоннектор);
	
	Если Ответ.Ошибка Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Попытка
		ДанныеФайловБакета = РазобратьОтветФайловБакета(ОтветКоннектор);
		ЗаполнитьЗначенияСвойств(Ответ, ДанныеФайловБакета);
	Исключение
		
		Ответ.Ошибка              = Истина;
		Ответ.Сообщение           = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Ответ.КлассификацияОшибки = "ОшибкаЧтенияДанныхСервиса";
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

// Возвращает MIME тип по для переданного расширения.
//
// Параметры:
//  Расширение - Строка - расширение файла с точкой.
//
// Возвращаемое значение:
//  Строка - MIME тип, если расширение не удалось найти, возвращает binary/octet-stream.
//
Функция MIMEТипДляРасширенияФайла(Расширение) Экспорт
	
	MIMEТипПоУмолчанию = "binary/octet-stream";
	
	Если Не ЗначениеЗаполнено(Расширение) Тогда
		Возврат MIMEТипПоУмолчанию;
	КонецЕсли;
	
	РасширениеДляПоиска = "." + ох_ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(Расширение);
	
	MIMEТип = СоответствиеРасширенийContentType()[РасширениеДляПоиска];
	Если ЗначениеЗаполнено(MIMEТип) Тогда
		Возврат MIMEТип;
	Иначе
		Возврат MIMEТипПоУмолчанию;
	КонецЕсли;
	
КонецФункции

