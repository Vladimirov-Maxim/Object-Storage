Функция СформироватьОтветОбработкиБакета(ОтветКоннектор)
	
	Ответ = СформироватьОтвет(ОтветКоннектор);
	ох_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Ответ, НовыйОтветФайлыБакета());
	Возврат Ответ;
	
