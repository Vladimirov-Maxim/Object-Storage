		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.СервисныйАккаунт</dataPath>
			<field>СервисныйАккаунт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сервисный аккаунт</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.Бакет</dataPath>
			<field>Бакет</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Бакет</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.Операция</dataPath>
			<field>Операция</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Операция</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.Статус</dataPath>
			<field>Статус</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.Ответственный</dataPath>
			<field>Ответственный</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ответственный</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.ДатаОкончанияВыполнения</dataPath>
			<field>ДатаОкончанияВыполнения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата окончания выполнения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.КоличествоПопытокВыполнения</dataPath>
			<field>КоличествоПопытокВыполнения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество попыток выполнения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.ИдентификаторЗаписи</dataPath>
			<field>ИдентификаторЗаписи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Идентификатор записи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗависшиеЗадания.ИдентификаторФайла</dataPath>
			<field>ИдентификаторФайла</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Идентификатор файла</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторПотока КАК ИдентификаторПотока,
	ох_ЗаданияДляОбработкиОбъектовХранилища.Период КАК Период,
	ох_ЗаданияДляОбработкиОбъектовХранилища.Файл КАК Файл,
	ох_ЗаданияДляОбработкиОбъектовХранилища.СервисныйАккаунт КАК СервисныйАккаунт,
	ох_ЗаданияДляОбработкиОбъектовХранилища.Бакет КАК Бакет,
	ох_ЗаданияДляОбработкиОбъектовХранилища.Операция КАК Операция,
	ох_ЗаданияДляОбработкиОбъектовХранилища.Статус КАК Статус,
	ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаНачалаВыполнения КАК ДатаНачалаВыполнения,
	ох_ЗаданияДляОбработкиОбъектовХранилища.Ответственный КАК Ответственный,
	ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаОкончанияВыполнения КАК ДатаОкончанияВыполнения,
	ох_ЗаданияДляОбработкиОбъектовХранилища.КоличествоПопытокВыполнения КАК КоличествоПопытокВыполнения,
	ох_ЗаданияДляОбработкиОбъектовХранилища.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	ох_ЗаданияДляОбработкиОбъектовХранилища.ИдентификаторФайла КАК ИдентификаторФайла
ИЗ
	РегистрСведений.ох_ОчередьЗаданийОбъектногоХранилища КАК ох_ОчередьЗаданийОбъектногоХранилища
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ох_ЗаданияДляОбработкиОбъектовХранилища КАК ох_ЗаданияДляОбработкиОбъектовХранилища
		ПО ох_ОчередьЗаданийОбъектногоХранилища.ИдентификаторЗаписи = ох_ЗаданияДляОбработкиОбъектовХранилища.ИдентификаторЗаписи
ГДЕ
	ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаНачалаВыполнения &gt;= &amp;Период</query>
	</dataSet>
