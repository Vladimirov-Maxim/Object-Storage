<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ВремяВыполненияЗаданий</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВремяВыполненияЗаданий.ВремяПодготовкиОчереди</dataPath>
			<field>ВремяПодготовкиОчереди</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Время выполнения заданий.Время подготовки очереди</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВремяВыполненияЗаданий.ОбщееВремяВыполнения</dataPath>
			<field>ОбщееВремяВыполнения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Время выполнения заданий.Общее время выполнения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВремяВыполненияЗаданий.ВремяВыполненияЗадания</dataPath>
			<field>ВремяВыполненияЗадания</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Время выполнения заданий.Время выполнения задания</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫРАЗИТЬ(СРЕДНЕЕ(РАЗНОСТЬДАТ(ох_ЗаданияДляОбработкиОбъектовХранилища.Период, ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаОкончанияВыполнения, СЕКУНДА)) КАК ЧИСЛО(10, 2)) КАК ОбщееВремяВыполнения,
	ВЫРАЗИТЬ(СРЕДНЕЕ(РАЗНОСТЬДАТ(ох_ЗаданияДляОбработкиОбъектовХранилища.Период, ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаНачалаВыполнения, СЕКУНДА)) КАК ЧИСЛО(10, 2)) КАК ВремяПодготовкиОчереди,
	ВЫРАЗИТЬ(СРЕДНЕЕ(РАЗНОСТЬДАТ(ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаНачалаВыполнения, ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаОкончанияВыполнения, СЕКУНДА)) КАК ЧИСЛО(10, 2)) КАК ВремяВыполненияЗадания
ИЗ
	РегистрСведений.ох_ЗаданияДляОбработкиОбъектовХранилища КАК ох_ЗаданияДляОбработкиОбъектовХранилища
ГДЕ
	ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаОкончанияВыполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
	И ох_ЗаданияДляОбработкиОбъектовХранилища.ДатаНачалаВыполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
	И ох_ЗаданияДляОбработкиОбъектовХранилища.Период &gt;= &amp;Период</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
