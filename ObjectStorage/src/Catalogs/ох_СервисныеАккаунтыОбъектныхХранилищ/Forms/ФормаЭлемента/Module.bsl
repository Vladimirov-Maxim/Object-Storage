
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЗагрузитьКлючиИзХранилища(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	СохранитьКлючиВХранилище(Отказ, ТекущийОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИдентификаторКлючаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ох_ОбщегоНазначенияКлиент.ПолеПароляНачалоВыбора(Элемент, ИдентификаторКлюча, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СекретныйКлючНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ох_ОбщегоНазначенияКлиент.ПолеПароляНачалоВыбора(Элемент, СекретныйКлюч, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	ПроверитьПодключениеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьКлючиИзХранилища(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Ключи = ох_ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка, "ИдентификаторКлюча, СекретныйКлюч");
	
	Если Ключи <> Неопределено Тогда
		// BSLLS:UnusedLocalVariable-off ИдентификаторКлюча/СекретныйКлюч - реквизиты формы (Form.xml), читаются в СохранитьКлючиВХранилище; bsl-ls не резолвит реквизиты формы.
		ИдентификаторКлюча = Ключи.ИдентификаторКлюча;
		СекретныйКлюч      = Ключи.СекретныйКлюч;
		// BSLLS:UnusedLocalVariable-on
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьКлючиВХранилище(Отказ, ТекущийОбъект)
	
	Если Не Отказ Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ох_ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, ИдентификаторКлюча, "ИдентификаторКлюча");
		ох_ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, СекретныйКлюч, "СекретныйКлюч");
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПодключениеНаСервере()
	
	Настройки = Справочники.ох_СервисныеАккаунтыОбъектныхХранилищ.НовыйНастройкиСервисногоАккаунта();
	ЗаполнитьЗначенияСвойств(Настройки, Объект);
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	
	Результат = ох_КоннекторS3.ПроверитьПодключение(Объект.Ссылка, Настройки);
	
	Если Не Результат.Ошибка Тогда
		ох_ОбщегоНазначения.СообщитьПользователю("Подключение установлено");
	Иначе
		ВызватьИсключение Результат.Сообщение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти